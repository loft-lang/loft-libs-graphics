// @FR-Oracle-Golden — the expected bytes in this file are the oracle's own.
// The brush stroke, against the picture the oracle produced and the shape the
// design claims.
//
// Two goldens are `draw.py`'s own bytes for a `Lock` — one on a transparent
// sprite, one curved on an opaque ground with its own shadow colour — so the
// port is held to the standard every other mark is: the corpus gate in
// miniature, needing no Python.  The shape tests are crawler's
// `tools/lock_probe.py` measurements made here on the same scenes: a lock is
// narrower where it grows than in its body, brighter on top than underneath,
// splits into its `tips`, and paints over the lock behind it.
use drawing;
use graphics;

const HEX_DIGITS = "0123456789abcdef";

fn byte_hex(v: integer) -> text {
  hi = (v >> 4) & 15;
  lo = v & 15;
  HEX_DIGITS[hi..hi + 1] + HEX_DIGITS[lo..lo + 1]
}

/// The canvas as Pillow lays an RGBA image out in memory: R, G, B, A per pixel.
fn rgba_hex(cv: const graphics::Canvas) -> text {
  h = "";
  for i in 0..(cv.width * cv.height) {
    c = cv.data[i]?;
    h += byte_hex(graphics::color_r(c)) + byte_hex(graphics::color_g(c))
       + byte_hex(graphics::color_b(c)) + byte_hex(graphics::color_a(c));
  }
  h
}

fn sprite_source() -> text {
  `
  size 24x16
  Background transparent
  Lock (0.1,0.5) (0.9,0.5) w0=1 w=6 tips=2 rgb=120,80,40
  `
}

