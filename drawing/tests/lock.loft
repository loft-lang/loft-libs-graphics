// ── The shape the design claims, measured ───────────────────────────

/// Differs from the mid-grey ground by more than 20 in some channel.
fn painted(cv: const graphics::Canvas, x: integer, y: integer) -> boolean {
  pc = cv.get_pixel(x, y);
  pr = graphics::color_r(pc) - 128;
  pg = graphics::color_g(pc) - 128;
  pb = graphics::color_b(pc) - 128;
  if pr < 0 { pr = -pr; }
  if pg < 0 { pg = -pg; }
  if pb < 0 { pb = -pb; }
  pr > 20 || pg > 20 || pb > 20
}

fn column_ink(cv: const graphics::Canvas, x: integer) -> integer {
  ci_n = 0;
  for y in 0..cv.height { if painted(cv, x, y) { ci_n += 1; } }
  ci_n
}

/// How many separate painted runs a column crosses.
fn runs_down(cv: const graphics::Canvas, x: integer) -> integer {
  rd_n = 0;
  rd_in = false;
  for y in 0..cv.height {
    rd_p = painted(cv, x, y);
    if rd_p && !rd_in { rd_n += 1; }
    rd_in = rd_p;
  }
  rd_n
}

fn lum(c: integer) -> float {
  0.299 * (graphics::color_r(c) as float) + 0.587 * (graphics::color_g(c) as float)
  + 0.114 * (graphics::color_b(c) as float)
}

/// Mean luminance of the PAINTED pixels in `[x0, x1) × [y0, y1)`.
fn band_lum(cv: const graphics::Canvas, x0: integer, x1: integer, y0: integer, y1: integer) -> float {
  bl_s = 0.0;
  bl_n = 0;
  for y in y0..y1 {
    for x in x0..x1 {
      if painted(cv, x, y) { bl_s += lum(cv.get_pixel(x, y)); bl_n += 1; }
    }
  }
  (bl_s / (bl_n as float)) ?? 0.0
}

struct Rgb {
  r: float = 0.0,
  g: float = 0.0,
  b: float = 0.0,
}

/// Mean colour of every pixel in `[x0, x1] × [y0, y1]`.
fn band_mean(cv: const graphics::Canvas, x0: integer, x1: integer, y0: integer, y1: integer) -> Rgb {
  bm_n = 0;
  bm_r = 0.0;
  bm_g = 0.0;
  bm_b = 0.0;
  for y in y0..=y1 {
    for x in x0..=x1 {
      bm_c = cv.get_pixel(x, y);
      bm_r += graphics::color_r(bm_c) as float;
      bm_g += graphics::color_g(bm_c) as float;
      bm_b += graphics::color_b(bm_c) as float;
      bm_n += 1;
    }
  }
  Rgb { r: (bm_r / (bm_n as float)) ?? 0.0, g: (bm_g / (bm_n as float)) ?? 0.0,
        b: (bm_b / (bm_n as float)) ?? 0.0 }
}

fn lock_source() -> text {
  `
  size 120x60
  Background top=0.5 bottom=0.5
  Lock (0.05,0.5) (0.95,0.5) w0=2 w=20 tips=3 tipvar=0 spread=0 rgb=120,80,40
  `
}

fn test_the_lock_has_the_shape_it_claims() {
  cv = render(parse_scene(lock_source()));
  // The lock runs x = 6..114; its body ends at t = 0.8 (x ≈ 92), the spikes after.
  root = column_ink(cv, 8);
  body = column_ink(cv, 60);
  assert(root * 2 < body, "narrower where it grows: root {root} px, body {body} px");
  top = band_lum(cv, 20, 80, 0, 30);
  bot = band_lum(cv, 20, 80, 31, 60);
  assert(top > bot + 20.0, "upper side brighter than the underside: {top} vs {bot}");
  assert(runs_down(cv, 94) == 1, "one body just past its end");
  assert(runs_down(cv, 105) == 3, "three spikes further out, got {runs_down(cv, 105)}");
  assert(!painted(cv, 118, 30), "nothing beyond the longest spike");
}

fn layers_source() -> text {
  `
  size 120x60
  Background top=0.5 bottom=0.5
  Lock (0.05,0.40) (0.95,0.40) w0=20 w=20 swell=0 body=1 tips=0 rgb=200,40,40
  Lock (0.05,0.60) (0.95,0.60) w0=20 w=20 swell=0 body=1 tips=0 rgb=40,40,200
  `
}

fn test_a_lock_paints_over_the_lock_behind_it() {
  cv = render(parse_scene(layers_source()));
  both = band_mean(cv, 40, 80, 27, 33);
  red_only = band_mean(cv, 40, 80, 18, 24);
  assert(both.b > both.r + 30.0, "the later (blue) lock covers the earlier where they overlap");
  assert(red_only.r > red_only.b + 30.0, "the earlier (red) lock is untouched where they do not");
}

fn test_a_lock_names_a_brush_that_exists_or_is_reported() {
  sc = parse_scene("size 8x8\nLock (0.1,0.5) (0.9,0.5) brush=nope\n"
                   + "Brush fur hair w=6 period=8\nLock (0.1,0.5) (0.9,0.5) brush=fur\n");
  assert(len(sc.unparsed) == 1, "the lock naming no brush is reported, got {len(sc.unparsed)}");
  assert(len(sc.ops) == 1, "the lock naming a brush is an op");
  assert(len(sc.brushes) == 1, "one brush defined");
  assert(sc.brushes[0]?.bname == "fur" && sc.brushes[0]?.bw == 6 && sc.brushes[0]?.bh == 8,
         "the brush is the one the line described");
}
