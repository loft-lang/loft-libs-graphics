//
// The whole pipeline, against the picture the oracle actually produced.
//
// One 16x16 scene with a fill, a circle, a smooth stroke, a tapered stroke and a
// pen line — drawn at 3x and resampled down, exactly as `draw.py` does it.  The
// expected bytes below are `draw.py`'s own output for this source, so this test
// is the corpus gate in miniature: it needs no Python to run, and it fails the
// moment any stage of the pipeline stops agreeing.
use drawing;
use graphics;

const HEX_DIGITS = "0123456789abcdef";

fn byte_hex(v: integer) -> text {
  hi = (v >> 4) & 15;
  lo = v & 15;
  HEX_DIGITS[hi..hi + 1] + HEX_DIGITS[lo..lo + 1]
}

/// The canvas as Pillow lays an RGBA image out in memory: R, G, B, A per pixel.
fn rgba_hex(cv: const graphics::Canvas) -> text {
  h = "";
  for i in 0..(cv.width * cv.height) {
    c = cv.data[i]?;
    h += byte_hex(graphics::color_r(c)) + byte_hex(graphics::color_g(c))
       + byte_hex(graphics::color_b(c)) + byte_hex(graphics::color_a(c));
  }
  h
}

fn scene_source() -> text {
  `
  size 16x16
  Background transparent
  name body
  Poly (0.15,0.20) (0.80,0.25) (0.70,0.85) (0.20,0.80) rgb=190,60,50
  Circle (0.50,0.45) r=0.22 rgb=40,120,180
  name trim
  Poly (0.10,0.90)~ (0.50,0.55)~ (0.90,0.92)~ stroke=20,220,90 w=2
  Poly (0.20,0.30)@6 (0.85,0.40)@1 stroke=250,240,60
  Line (0.05,0.05) - (0.95,0.15) w=1
  `
}

fn test_the_rendered_picture_is_the_oracles() {
  sc = parse_scene(scene_source());
  assert(len(sc.unparsed) == 0, "every line parsed");
  assert(len(sc.deferred) == 0, "every mark is one this build draws");
  cv = render(sc);
  assert(cv.width == 16 && cv.height == 16, "16x16 out");
  assert(rgba_hex(cv) ==
"231f2341282226782521236c150d2260151523243a3427273f3f1f100000000000000000000000000000000000000000" +
    "00000000000000000000000000000000241d24232820256526212463564e28a22f2926a10d0722861d1623a72b26249a" +
