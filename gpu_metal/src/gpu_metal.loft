//
// The Metal backend of `gpu`.
//
//   dev = gpu::open(gpu_metal::table(), 960, 720, "view") ?? return;
//
// A game does not name this library: its host package asks each backend in turn.  A program's
// source for it carries the tag "msl" and is the Metal Shading Language:
//   - the vertex function is `vertex_main` and the fragment function `fragment_main`; the two
//     sources are compiled apart, so each declares what both use;
//   - the inputs read per vertex are `[[attribute(0)]]` onwards of the `[[stage_in]]` struct, in
//     the program's order, and the inputs read per copy follow them;
//   - the uniform block is a struct at `[[buffer(0)]]`; a block laid out otherwise than the
//     program declares builds no pipeline, and stderr shows both layouts;
//   - texture slot n is `[[texture(n)]]` and its sampler `[[sampler(n)]]`; a depth texture is a
//     `depth2d<float>`;
//   - the vertex function hands its position to `gpu_position(...)`, which this backend defines
//     ahead of the source: a position is written in `gpu`'s clip space (depth from -1 to 1), as
//     for every backend, and that call turns it into Metal's.

fn gm_table() -> integer;
#c "gm_table" "int64_t()"

// This backend's table, for `gpu::open`; 0 on a machine that is not a Mac.  `open` answers null
// on a Mac with no Metal.
pub fn table() -> i64 {
  gm_table()
}

fn gm_check(on: integer);
#c "gm_check" "void(int64_t)"
fn gm_faults() -> integer;
#c "gm_faults" "int64_t()"
fn gm_checked() -> integer;
#c "gm_checked" "int64_t()"
fn gm_check_self() -> integer;
#c "gm_check_self" "int64_t()"

// Whether this library was built checked (`c/checked.sh`) and its checks are on.  The library
// as it is published is not, and pays nothing for the checks: `faults` is then always 0.
//
// Metal's own validation (`MTL_DEBUG_LAYER=1`) sees a wrong call of Metal.  A checked build
// sees what it cannot: a buffer, texture, target or
// pipeline of this backend used after its release, released twice, or used after its device
// closed.  The call is refused, counted, and written to stderr with the call it came from.
// `GPU_METAL_DEBUG=abort` stops the program at the first fault, `GPU_METAL_DEBUG=0` turns
// the checks off.
pub fn checked() -> boolean {
  gm_checked() != 0
}

// Turn a checked build's checks off, or on again.  Ask before `table()`: a device opened
// through a table taken earlier keeps what that table did.
pub fn check(on: boolean) {
  gm_check(if on { 1 } else { 0 });
}

// How many faults a checked build has seen in this program.
pub fn faults() -> integer {
  gm_faults()
}

// For this library's own tests: release one buffer of the window opened last twice, then give
// it to a draw, as no program can through `gpu`, and answer how many faults that added — 2 in a
// checked build with its checks on (and not set to abort), 0 otherwise.
pub fn check_catches() -> integer {
  gm_check_self()
}
