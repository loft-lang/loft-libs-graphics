//
// `asan/run.sh`'s first step: C that reads a freed block on purpose.

fn asan_selftest_read_freed(n: integer) -> integer;
#c "asan_selftest_read_freed" "int64_t(int64_t)"

// Read a block after its release.  A sanitized build stops here.
pub fn read_freed(n: integer) -> integer {
  asan_selftest_read_freed(n)
}
