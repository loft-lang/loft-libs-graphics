//
// stage — a retained 2-D scene: the tree a game mutates instead of a frame loop
// it draws.  @PLN144 arc A.
//
// ⚠ THE TREE IS FLAT.  Nodes live in one `vector<StageNode>` and a child names its
// parent by INDEX, never by reference.  Two reasons, and the second is why it
// stays that way even though a pointer tree reads more naturally:
//
//   * a parent holding its children while a child points back is a dependency
//     cycle in loft's ownership model, and
//   * a flat array IS the instance buffer the batched renderer wants, so the
//     shape that avoids the cycle is also the shape `A3` needs.
//
// The invariant that makes composition one forward pass: **a parent always has a
// lower index than its children**.  `node_add` enforces it rather than trusting
// it, because a single out-of-order insert would make `compose` read a parent's
// world transform before it was written — and produce a *plausible* wrong answer
// rather than an error.

use graphics;

// A node's local placement, plus the world affine `compose` derives for it.
//
// ⚠ NAMED `StageNode` AND NOT `Node`, because a type name is GLOBAL across the
// dependency graph and `mesh3d` — which `graphics` pulls in — already publishes a
// `Node` for its 3-D scene.  The compiler refuses the collision outright rather
// than resolving it silently, which is the good outcome; the cost of finding it
// after publishing would have been a rename nobody can make.
//
// The affine is 2x3 and is applied as
//     x' = a*lx + c*ly + tx
//     y' = b*lx + d*ly + ty
// which is the layout the instanced draw path consumes unchanged.
pub struct StageNode {
    nd_parent: integer,      // index of the parent, or -1 for a root
    nd_x: float,             // where the ORIGIN lands, in the parent's space
    nd_y: float,
    nd_rot: float,           // radians; +ve turns +x toward +y
    nd_sx: float,
    nd_sy: float,
    nd_ox: float,            // the origin, in the node's own units: put it at the
    nd_oy: float,            // sprite's feet and the sprite stands up from (x, y)
    nd_w: float,
    nd_h: float,
    nd_colour: integer,
    nd_visible: boolean,
    nd_atlas: integer,
    nd_u0: float,
    nd_v0: float,
    nd_u1: float,
    nd_v1: float,
    nd_alpha: float,
    nd_a: float,             // derived world affine — read after `compose`
    nd_b: float,
    nd_c: float,
    nd_d: float,
    nd_tx: float,
    nd_ty: float,
}

pub struct Stage {
    st_nodes: vector<StageNode>,
}

// Where to put a node, and how.  A struct rather than nine parameters because the
// compiler said so — `too-many-parameters` fires at eight, and a caller's burden
// is fixed by a struct where a reader's is fixed by an extracted function.
//
// ⚠ THE DEFAULTS ARE THE POINT, not convenience.  Scale defaults to 1.0 and not to
// the zero an omitted field would otherwise take: a scale of 0 is a *meaningful*
// value of the field's domain — it collapses the node to nothing — so an author
// who writes `Place { pl_x: 10.0, pl_y: 20.0 }` and gets an invisible node has
// been handed a legal answer to a question they did not ask.  That is exactly the
// case `omitted-field-zero` exists to warn about, answered here at the declaration.
pub struct Place {
    pl_w: float = 0.0,       // size in the node's own units; 0 x 0 draws nothing
    pl_h: float = 0.0,
    pl_colour: integer = 0,  // packed 0xRRGGBB, as `DrawRect` carries
    pl_visible: boolean = true,
    pl_atlas: integer = 0,   // which texture page; a run may only merge within one
    pl_u0: float = 0.0,      // the sprite's rect within that page
    pl_v0: float = 0.0,
    pl_u1: float = 1.0,
    pl_v1: float = 1.0,
    pl_alpha: float = 1.0,
    pl_x: float = 0.0,
    pl_y: float = 0.0,
    pl_rot: float = 0.0,     // radians; +ve turns +x toward +y
    pl_sx: float = 1.0,
    pl_sy: float = 1.0,
    pl_ox: float = 0.0,      // the origin, in the node's own units
    pl_oy: float = 0.0,
}

// A point, so a caller can ask where something ended up without unpacking six
// floats.  `world_point` is the only honest way to check a transform: a matrix
// means nothing except through what it does to a point.
pub struct P2 {
    p_x: float,
    p_y: float,
}

pub fn stage_new() -> Stage {
    Stage { st_nodes: [] }
}

pub fn node_count(self: const Stage) -> integer {
    len(self.st_nodes)
}

// Add a node and answer its index.  `parent` is -1 for a root.
//
// ⚠ Refuses a forward parent reference by answering -1.  `compose` is a single
// forward pass, so a child placed before its parent would read an unwritten world
// transform — silently, and the frame would look almost right.
// Example: @STG-002 — the tree is a flat array and a forward parent reference is
// refused, because `compose` is a single forward pass that would otherwise read an
// unwritten parent and answer plausibly.
pub fn node_add(self: Stage, parent: integer, p: const Place) -> integer {
    idx = len(self.st_nodes);
    if parent >= idx or parent < -1 { return -1; }
    self.st_nodes += [StageNode {
        nd_parent: parent, nd_x: p.pl_x, nd_y: p.pl_y, nd_rot: p.pl_rot,
        nd_sx: p.pl_sx, nd_sy: p.pl_sy, nd_ox: p.pl_ox, nd_oy: p.pl_oy,
        nd_w: p.pl_w, nd_h: p.pl_h, nd_colour: p.pl_colour, nd_visible: p.pl_visible,
        nd_atlas: p.pl_atlas, nd_u0: p.pl_u0, nd_v0: p.pl_v0, nd_u1: p.pl_u1,
        nd_v1: p.pl_v1, nd_alpha: p.pl_alpha,
        nd_a: 1.0, nd_b: 0.0, nd_c: 0.0, nd_d: 1.0, nd_tx: 0.0, nd_ty: 0.0,
    }];
    idx
}

// Derive every node's world affine in one forward pass.
//
// A node's local transform is  T(x, y) . R(rot) . S(sx, sy) . T(-ox, -oy), which
// is what makes the ORIGIN the anchor: the local point (ox, oy) maps exactly to
// (x, y), so a sprite whose origin sits at its feet stands up from where it is
// placed.  World = parent's world composed with that.
// Example: @STG-003 — deriving is the caller's to trigger; skipping it renders the
// previous state, which reads as input lag rather than as a missing call.
pub fn compose(self: Stage) {
    for i in 0..len(self.st_nodes) {
        n = self.st_nodes[i];
        cs = cos(n.nd_rot);
        sn = sin(n.nd_rot);
        // R . S — scale first, then rotate.
        la = cs * n.nd_sx;
        lb = sn * n.nd_sx;
        lc = -sn * n.nd_sy;
        ld = cs * n.nd_sy;
        // ... then place the ORIGIN at (x, y): t = (x, y) - A . (ox, oy).
        ltx = n.nd_x - (la * n.nd_ox + lc * n.nd_oy);
        lty = n.nd_y - (lb * n.nd_ox + ld * n.nd_oy);

        if n.nd_parent < 0 {
            self.st_nodes[i].nd_a = la;
            self.st_nodes[i].nd_b = lb;
            self.st_nodes[i].nd_c = lc;
            self.st_nodes[i].nd_d = ld;
            self.st_nodes[i].nd_tx = ltx;
            self.st_nodes[i].nd_ty = lty;
        } else {
            p = self.st_nodes[n.nd_parent];
            // W = P . L  — the parent's linear part acts on the child's, and on
            // the child's translation before the parent's is added.
            self.st_nodes[i].nd_a = p.nd_a * la + p.nd_c * lb;
            self.st_nodes[i].nd_b = p.nd_b * la + p.nd_d * lb;
            self.st_nodes[i].nd_c = p.nd_a * lc + p.nd_c * ld;
            self.st_nodes[i].nd_d = p.nd_b * lc + p.nd_d * ld;
            self.st_nodes[i].nd_tx = p.nd_a * ltx + p.nd_c * lty + p.nd_tx;
            self.st_nodes[i].nd_ty = p.nd_b * ltx + p.nd_d * lty + p.nd_ty;
        }
    }
}

// Where a point in node `idx`'s own space lands in world space.  Valid after
// `compose`; answers (0, 0) for an index that is not a node.
pub fn world_point(self: const Stage, idx: integer, lx: float, ly: float) -> P2 {
    if idx < 0 or idx >= len(self.st_nodes) { return P2 { p_x: 0.0, p_y: 0.0 }; }
    n = self.st_nodes[idx];
    P2 { p_x: n.nd_a * lx + n.nd_c * ly + n.nd_tx,
         p_y: n.nd_b * lx + n.nd_d * ly + n.nd_ty }
}

// Where the node's ORIGIN is — the point A7's depth key sorts on.
// Example: @STG-001 — a node is anchored by its origin, so a sprite whose origin
// sits at its feet stands up from where it was placed.
pub fn world_origin(self: const Stage, idx: integer) -> P2 {
    if idx < 0 or idx >= len(self.st_nodes) { return P2 { p_x: 0.0, p_y: 0.0 }; }
    n = self.st_nodes[idx];
    world_point(self, idx, n.nd_ox, n.nd_oy)
}


// ── A2: the draw list ────────────────────────────────────────────────────────
//
// ⚠ THESE THREE TYPES ARE NOT NEW.  Their field names and types are copied
// EXACTLY from `lavition_ui`, which produces `vector<DrawRect>` from
// `panel_draw_list` today and is proven by a 12 k-line editor.  Matching a working
// command shape rather than minting a rival one is the whole point: a game's UI
// and an editor's UI have to reach the GPU by one path, or the batcher sees two.
//
// ⚠ AND THEY NEED ONE HOME, WHICH THEY DO NOT YET HAVE.  `lavition_ui` is
// unpublished, so its `DrawRect` and this one are two nominal types with one
// shape.  Until it is published (@PLN145 `D0`) the types cannot literally be
// shared, and one of the two must eventually give — see the plan.
pub struct UiRect {
    r_x: integer,
    r_y: integer,
    r_w: integer,
    r_h: integer,
}

// A packed 0xRRGGBB colour, as `lavition_ui` carries it.
pub struct DrawRect {
    dr_rect: UiRect,
    dr_colour: integer,
}

pub struct DrawText {
    dt_text: text,
    dt_x: integer,
    dt_y: integer,           // TOP of the line, which is what draw-a-texture wants
    dt_colour: integer,
}

// Emit the scene as a flat command list, in index order.
//
// Index order IS the draw order for now: `A4` gives depth its own key, and doing
// it here would be a second ordering rule to keep in step with that one.  A node
// with no area emits nothing — a zero size is how a pure transform parent says it
// is scaffolding rather than a thing to look at.
pub fn draw_list(self: const Stage) -> vector<DrawRect> {
    out: vector<DrawRect> = [];
    for i in 0..len(self.st_nodes) {
        n = self.st_nodes[i];
        if !n.nd_visible { continue; }
        if n.nd_w <= 0.0 or n.nd_h <= 0.0 { continue; }
        // The origin is the anchor, so the rect starts there and extends by the
        // node's size through its own scale — which is what `nd_a`/`nd_d` carry.
        o = world_point(self, i, n.nd_ox, n.nd_oy);
        far = world_point(self, i, n.nd_ox + n.nd_w, n.nd_oy + n.nd_h);
        x0 = o.p_x;
        y0 = o.p_y;
        w = far.p_x - x0;
        h = far.p_y - y0;
        if w < 0.0 { x0 = far.p_x; w = -w; }
        if h < 0.0 { y0 = far.p_y; h = -h; }
        out += [DrawRect {
            dr_rect: UiRect { r_x: x0 as integer, r_y: y0 as integer,
                              r_w: w as integer, r_h: h as integer },
            dr_colour: n.nd_colour,
        }];
    }
    out
}

// Paint a command list onto a software canvas.
//
// ⚠ THE ALPHA BYTE IS ADDED HERE, and it has to be.  A `DrawRect` carries
// 0xRRGGBB — `lavition_ui` says so, and keeps it a plain integer so it needs no
// graphics dependency — while `graphics::Canvas` reads 0xAARRGGBB and treats a
// missing top byte as FULLY TRANSPARENT.  That is `graphics`' own `@GFX-001`
// trap: the colour looks right in the source and paints nothing.  One `| 0xff000000`
// at the boundary is the whole fix, and it belongs at the boundary rather than in
// every caller.
pub fn render(list: const vector<DrawRect>, cv: graphics::Canvas) {
    for d in list {
        cv.fill_rect(d.dr_rect.r_x, d.dr_rect.r_y, d.dr_rect.r_w, d.dr_rect.r_h,
                     opaque(d.dr_colour));
    }
}

// 0xRRGGBB -> 0xAARRGGBB, leaving an already-opaque colour alone.
pub fn opaque(colour: integer) -> integer {
    if (colour & 0xff000000) != 0 { return colour; }
    colour | 0xff000000
}


// ── A3a: the batcher ─────────────────────────────────────────────────────────
//
// ⚠ MERGE ADJACENT RUNS ONLY — NEVER SORT.  2-D correctness is painter's algebra:
// overlapping translucent draws must composite in call order, so a batcher may
// merge *consecutive* commands that share state and must break on a change.  It
// may not gather every command of one atlas together, however much cheaper that
// would be, because that reorders the picture.
//
// The honest cost, and it is not small: a scene that interleaves two atlases
// sprite-by-sprite degenerates to one instance per run.  That is a PACKING
// problem, answered where the atlas is built — sprites that draw near each other
// must share a page — and not something the batcher may fix by reordering.

// One run of consecutive instances that share an atlas.
pub struct Batch {
    b_atlas: integer,
    b_first: integer,        // index of the first instance in the packed buffer
    b_count: integer,
}

// Floats per instance in the packed buffer: a 2x3 affine, the sprite's uv rect,
// and a premultiplied-ready rgba.  The stride is public because a caller wiring
// `gl_instance_attrib` needs it, and a wrong one fails as garbage geometry rather
// than as an error.
pub const INSTANCE_STRIDE: integer = 14;

// Offsets within one instance, for the same reason.
pub const OFF_AFFINE: integer = 0;   // a, b, c, d, tx, ty
pub const OFF_UV: integer = 6;       // u0, v0, u1, v1
pub const OFF_RGBA: integer = 10;    // r, g, b, a

// Split the visible nodes into runs, in scene order.
// Example: @STG-004 — adjacent runs only, never sorted, and what the interleave
// costs: four sprites across two atlases are four draws, cured by packing.
pub fn batches(self: const Stage) -> vector<Batch> {
    out: vector<Batch> = [];
    idx = 0;
    for i in 0..len(self.st_nodes) {
        n = self.st_nodes[i];
        if !n.nd_visible or n.nd_w <= 0.0 or n.nd_h <= 0.0 { continue; }
        last = len(out) - 1;
        if last >= 0 and out[last].b_atlas == n.nd_atlas {
            out[last].b_count = out[last].b_count + 1;
        } else {
            out += [Batch { b_atlas: n.nd_atlas, b_first: idx, b_count: 1 }];
        }
        idx = idx + 1;
    }
    out
}

// Pack every visible node into one instance buffer, in the same order `batches`
// counted.  The two walk the scene by the same rule, so a batch's `b_first` and
// `b_count` index this buffer directly.
pub fn pack_instances(self: const Stage) -> vector<single> {
    out: vector<single> = [];
    for i in 0..len(self.st_nodes) {
        n = self.st_nodes[i];
        if !n.nd_visible or n.nd_w <= 0.0 or n.nd_h <= 0.0 { continue; }
        // The affine already carries rotation and scale; the node's SIZE folds in
        // here so the shader can keep drawing a unit quad.
        out += [(n.nd_a * n.nd_w) as single];
        out += [(n.nd_b * n.nd_w) as single];
        out += [(n.nd_c * n.nd_h) as single];
        out += [(n.nd_d * n.nd_h) as single];
        o = world_point(self, i, n.nd_ox, n.nd_oy);
        out += [o.p_x as single];
        out += [o.p_y as single];
        out += [n.nd_u0 as single];
        out += [n.nd_v0 as single];
        out += [n.nd_u1 as single];
        out += [n.nd_v1 as single];
        out += [(((n.nd_colour >> 16) & 255) as float / 255.0) as single];
        out += [(((n.nd_colour >> 8) & 255) as float / 255.0) as single];
        out += [((n.nd_colour & 255) as float / 255.0) as single];
        out += [n.nd_alpha as single];
    }
    out
}
