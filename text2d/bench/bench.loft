//
// bench — the performance pass: the package's hot routines, timed on a fixed workload,
// with a hash of what they produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     rustc -O --edition=2021 bench/bench.rs -o bench/.build/stats_rs && bench/.build/stats_rs
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, items per op,
// ns per item, and an FNV-1a-32 hash of ONE canonical op's output.  The hash is what makes
// a benchmark a VALIDATION: the interpreter, the native build and the pure-Rust twin in
// bench/bench.rs must print the same hash for a row, or one of them is not computing the
// routine it claims to.
//
// The text is fixed by construction (`gen_code`), the same in every lane.  Each
// repetition's input differs in VALUE, never in the amount of work — a colour, an origin,
// a rotated key list, a letter shift — so no backend can hoist the op out of the loop, and
// each timed loop folds its result into a `sink` the last line carries.
use graphics;
use text2d;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

/// FNV-1a-32 over the low 32 bits of each integer, high byte first — a pixel's a, r, g, b.
fn fnv(h0: integer, v: const vector<integer>) -> integer {
  fv_h = h0;
  for x in v {
    fv_w = x & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 24) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 16) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 8) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ (fv_w & 255)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  fv_h
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

// ── The workload's text ─────────────────────────────────────────────

/// The code point at line `l`, column `k`: one of the 64 codes 32..95 (space, digits,
/// punctuation, capitals — eight of them without a glyph), a capital written lowercase in
/// every odd column so the fold is exercised too.
fn gen_code(l: integer, k: integer) -> integer {
  gc_raw = 32 + (l * 131 + k * 29) % 64;
  if gc_raw >= 65 and gc_raw <= 90 and (k & 1) == 1 { gc_raw + 32 } else { gc_raw }
}

fn gen_line(l: integer, cols: integer) -> text {
  gl_s = "";
  for k in 0..cols { gl_s += chr(gen_code(l, k)); }
  gl_s
}

fn gen_lines(count: integer, cols: integer) -> vector<text> {
  [for l in 0..count { gen_line(l, cols) }]
}

/// An atlas holding the 64 codes 32..95, cell = code − 32, so no op in the timed loops
/// writes the sheet.
fn warm_atlas(scale: integer) -> text2d::Atlas {
  wa_at = text2d::atlas_new(scale, 64);
  for c in 32..96 { _ = wa_at.atlas_cell(c); }
  wa_at
}

// ── write_text: one set_pixel call per lit sub-pixel ────────────────

const WT_LINES = 500;
const WT_COLS = 40;
const WT_SCALE = 2;
const WT_W = 480;    // 40 columns of 6 px at scale 2
const WT_H = 800;    // 50 rows of 16 px; line l lands on row l % 50

fn write_all(cv: graphics::Canvas, lines: const vector<text>, colour: integer) -> integer {
  wa_sum = 0;
  for l in 0..len(lines) {
    wa_sum += text2d::write_text(cv, lines[l]?, 0, (l % 50) * 16, colour, WT_SCALE);
  }
  wa_sum
}

/// How many pixels the glyph of `code` lights at scale 1, measured through the library.
fn lit_bits(code: integer) -> integer {
  lb_cv = graphics::canvas(6, 7, 0);
  _ = text2d::write_text(lb_cv, chr(code), 0, 0, 1, 1);
  lb_n = 0;
  for v in lb_cv.data { if v == 1 { lb_n += 1; } }
  lb_n
}

fn bench_write_text(n: integer) -> Row {
  bw_lines = gen_lines(WT_LINES, WT_COLS);
  bw_cv = graphics::canvas(WT_W, WT_H, 0);
  bw_t0 = ticks();
  bw_sink = 0;
  for r in 0..n {
    bw_sink += write_all(bw_cv, bw_lines, 0xFF203040 + (r & 1));
  }
  bw_us = ticks() - bw_t0;
  bw_one = graphics::canvas(WT_W, WT_H, 0);
  _ = write_all(bw_one, bw_lines, 0xFF203040);
  bw_calls = 0;
  for s in bw_lines {
    for c in s { bw_calls += lit_bits(c as integer) * WT_SCALE * WT_SCALE; }
  }
  Row { name: "write_text", iters: n, us: bw_us, px: bw_calls, hash: fnv(FNV_OFFSET, bw_one.data),
        sink: bw_sink + bw_cv.get_pixel(3, 3) }
}

// ── atlas_cell: a code looked up in the sheet ───────────────────────

const AC_KEYS = 64000;

fn cells_of(at: text2d::Atlas, keys: const vector<integer>) -> vector<integer> {
  co_out: vector<integer> = [];
  for k in keys { co_out += [at.atlas_cell(k)]; }
  co_out
}

fn sum_cells(at: text2d::Atlas, keys: const vector<integer>) -> integer {
  sc_sum = 0;
  for k in keys { sc_sum += at.atlas_cell(k); }
  sc_sum
}

fn bench_atlas_cell(n: integer) -> Row {
  ba_at = warm_atlas(1);
  ba_a: vector<integer> = [for i in 0..AC_KEYS { gen_code(i >> 6, i & 63) }];
  // The same keys rotated by one: the same lookups, in another order.
  ba_b: vector<integer> = [for i in 0..AC_KEYS { ba_a[(i + 1) % AC_KEYS]? }];
  ba_t0 = ticks();
  ba_sink = 0;
  for r in 0..n {
    ba_sink += if (r & 1) == 0 { sum_cells(ba_at, ba_a) } else { sum_cells(ba_at, ba_b) };
  }
  ba_us = ticks() - ba_t0;
  ba_one = cells_of(ba_at, ba_a);
  Row { name: "atlas_cell", iters: n, us: ba_us, px: AC_KEYS, hash: fnv(FNV_OFFSET, ba_one),
        sink: ba_sink + ba_at.atlas_writes() }
}

// ── layout: one Quad per character ──────────────────────────────────

const LY_STRINGS = 2000;
const LY_COLS = 32;

fn layout_all(at: text2d::Atlas, strs: const vector<text>, x0: integer) -> integer {
  la_sum = 0;
  for i in 0..len(strs) {
    la_qs = at.layout(strs[i]?, x0, i * 8);
    la_sum += len(la_qs) + (la_qs[0]?).q_cell;
  }
  la_sum
}

fn bench_layout(n: integer) -> Row {
  bl_at = warm_atlas(1);
  bl_strs = gen_lines(LY_STRINGS, LY_COLS);
  bl_t0 = ticks();
  bl_sink = 0;
  for r in 0..n { bl_sink += layout_all(bl_at, bl_strs, r & 1); }
  bl_us = ticks() - bl_t0;
  bl_ints: vector<integer> = [];
  for i in 0..len(bl_strs) {
    bl_qs = bl_at.layout(bl_strs[i]?, 0, i * 8);
    for q in bl_qs { bl_ints += [q.q_x, q.q_y, q.q_cell]; }
  }
  Row { name: "layout", iters: n, us: bl_us, px: LY_STRINGS * LY_COLS, hash: fnv(FNV_OFFSET, bl_ints),
        sink: bl_sink + bl_at.atlas_writes() }
}

// ── wrap: a paragraph broken into lines ─────────────────────────────

const WR_WORDS = 3400;
const WR_PX = 240;    // 40 columns of the built-in face at scale 1

/// The paragraph: words of 1–9 letters, a 45-letter word every 53rd (wider than the box,
/// so it is hard-broken), an 'é' now and then, a double space every 97th gap and a hard
/// break every 211th.  `shift` moves every letter along the alphabet and changes no
/// length, so variant 0 and 1 are the same work.
fn gen_paragraph(shift: integer) -> text {
  gp_s = "";
  for w in 0..WR_WORDS {
    gp_len = if w % 53 == 52 { 45 } else { 1 + (w * 7 + w / 3) % 9 };
    for j in 0..gp_len {
      if (w + j) % 17 == 0 { gp_s += "é"; }
      else { gp_s += chr(97 + (w * 5 + j * 3 + shift) % 26); }
    }
    if w % 211 == 210 { gp_s += "\n"; }
    else if w % 97 == 96 { gp_s += "  "; }
    else { gp_s += " "; }
  }
  gp_s
}

fn bench_wrap(n: integer) -> Row {
  bp_m = text2d::metrics_builtin(1);
  bp_a = gen_paragraph(0);
  bp_b = gen_paragraph(1);
  bp_t0 = ticks();
  bp_sink = 0;
  for r in 0..n {
    bp_lines = if (r & 1) == 0 { bp_m.wrap(bp_a, WR_PX) } else { bp_m.wrap(bp_b, WR_PX) };
    bp_sink += len(bp_lines);
  }
  bp_us = ticks() - bp_t0;
  bp_one = bp_m.wrap(bp_a, WR_PX);
  bp_ints: vector<integer> = [];
  for ln in bp_one {
    for c in ln { bp_ints += [c as integer]; }
    bp_ints += [-1];
  }
  Row { name: "wrap", iters: n, us: bp_us, px: len(bp_a), hash: fnv(FNV_OFFSET, bp_ints),
        sink: bp_sink }
}

// ── draw_quads: laid-out quads blitted from the sheet ───────────────

const DQ_LINES = 50;
const DQ_COLS = 40;
const DQ_SCALE = 2;

fn bench_draw_quads(n: integer) -> Row {
  bd_at = warm_atlas(DQ_SCALE);
  bd_quads: vector<text2d::Quad> = [];
  for l in 0..DQ_LINES { bd_quads += bd_at.layout(gen_line(l, DQ_COLS), 0, l * 16); }
  bd_cv = graphics::canvas(WT_W, WT_H, 0);
  bd_t0 = ticks();
  bd_sink = 0;
  for r in 0..n {
    text2d::draw_quads(bd_cv, bd_at, bd_quads, 0xFF405060 + (r & 1));
    bd_sink += bd_cv.get_pixel(3, 3);
  }
  bd_us = ticks() - bd_t0;
  bd_one = graphics::canvas(WT_W, WT_H, 0);
  text2d::draw_quads(bd_one, bd_at, bd_quads, 0xFF405060);
  bd_texels = len(bd_quads) * 5 * DQ_SCALE * 7 * DQ_SCALE;
  Row { name: "draw_quads", iters: n, us: bd_us, px: bd_texels, hash: fnv(FNV_OFFSET, bd_one.data),
        sink: bd_sink }
}

fn main() {
  mn_n = 20;
  mn_args = arguments();
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  mn_t0 = ticks();
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  mn_sink = 0;
  // `wrap` needs loft with loft#1657 fixed: before it, `lines += [flush_word(…, lines)]`
  // lost the line `flush_word` itself appended, and the hash disagreed with the twin's.
  for r in [bench_write_text(mn_n), bench_atlas_cell(mn_n), bench_layout(mn_n),
            bench_draw_quads(mn_n), bench_wrap(mn_n)] {
    print_row(r);
    mn_sink += r.sink;
  }
  println("time: {(ticks() - mn_t0) / 1000 ?? 0}ms sink={mn_sink}");
}
