//
// text2d — text that always draws.  @PLN144/@PLN145 arc B.
//
// ⚠ WHY A BUILT-IN FACE EXISTS AT ALL.  `graphics::write_text` needs three things
// at once: a GL context, the native rasteriser, and a font FILE.  Under `loft
// test` the rasteriser answers *"native function not loaded"*, so a repo that
// tests its UI headlessly answers by having no text — and two shipped surfaces in
// `dryopea` did exactly that: `hud.loft` draws its digits as RECTANGLES and
// `picker.loft` shipped without labels, each having reached that conclusion on its
// own.  A face baked in as data needs none of the three.
//
// This is a FALLBACK, and the word is load-bearing: its job is that text is never
// invisible, not that it is beautiful.  A real typeface arrives through the asset
// pack (@PLN146 F5/F6).
use graphics;
use face;

// Where the glyph for `code` starts in `face_rows`, or -1 if there is none.
// Lowercase folds to uppercase — see the note in `face.loft`.
fn glyph_at(code: integer) -> integer {
  c = code;
  if c >= 97 and c <= 122 { c = c - 32; }
  codes = face::face_codes();
  lo = 0;
  hi = len(codes) - 1;
  while lo <= hi {
    mid = (lo + hi) / 2 ?? 0;
    at = codes[mid] ?? -1;
    if at == c { return mid * face::GLYPH_H; }
    if at < c { lo = mid + 1; } else { hi = mid - 1; }
  }
  -1
}

// Width in pixels of `s` at scale 1, INCLUDING the single-pixel gap after every
// glyph but the last.  Exact — the caller can centre with it and be right.
pub fn text_width(s: text, scale: integer) -> integer {
  n = 0;
  for _c in s { n = n + 1; }
  if n == 0 { return 0; }
  (n * (face::GLYPH_W + 1) - 1) * scale
}

// Height of one line at `scale`.
pub fn line_height(scale: integer) -> integer { face::GLYPH_H * scale }

// ⚠ NAMED `write_text`, NOT `draw_text`.  `graphics` already has `draw_text` as a
// METHOD on `Canvas`, and a method spelling outranks a library's free function of
// the same name (loft#940) — so a bare `draw_text(cv, …)` here resolves to the
// seven-parameter GL one and fails at the call site with an arity error that names
// neither library.  A distinct verb costs nothing and is reachable.
//
// Draw `s` with its top-left at (x, y).  Answers the width drawn, so a caller can
// lay out the next run without measuring twice.
//
// ⚠ Iterates CHARACTERS, not bytes.  `len(text)` counts characters and an indexed
// read is bytes, so a byte loop truncates multi-byte text silently — the trap the
// strict-index lint exists for.  A character with no glyph draws a blank of the
// same width rather than being skipped, so a string never changes length because
// one character was missing.
pub fn write_text(cv: graphics::Canvas, s: text, x: integer, y: integer,
                 colour: integer, scale: integer) -> integer {
  sc = if scale < 1 { 1 } else { scale };
  rows = face::face_rows();
  pen = x;
  for ch in s {
    at = glyph_at(ch as integer);
    if at >= 0 {
      for ry in 0..face::GLYPH_H {
        bits = rows[at + ry] ?? 0;
        for rx in 0..face::GLYPH_W {
          if (bits & (1 << (face::GLYPH_W - 1 - rx))) != 0 {
            for sy in 0..sc {
              for sx in 0..sc {
                cv.set_pixel(pen + rx * sc + sx, y + ry * sc + sy, colour);
              }
            }
          }
        }
      }
    }
    pen = pen + (face::GLYPH_W + 1) * sc;
  }
  pen - x - sc
}

// Draw `s` centred in the box (bx, by, bw, bh).  The commonest thing a HUD wants,
// and the commonest place an off-by-one lands.
pub fn write_centred(cv: graphics::Canvas, s: text, bx: integer, by: integer,
                    bw: integer, bh: integer, colour: integer, scale: integer) -> integer {
  w = text_width(s, scale);
  h = line_height(scale);
  write_text(cv, s, bx + (bw - w) / 2 ?? 0, by + (bh - h) / 2 ?? 0, colour, scale)
}
