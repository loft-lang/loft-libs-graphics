//
// Worked examples for `text2d` (@PLN141): each `test_*` is a running demonstration of a
// contract the signatures cannot state, cited from the function it explains with
// `// Example: @T2D-00N`.
use graphics::*;
use text2d::*;

// @T2D-001 — what is measured is what is drawn.  `text_width` is the INK extent: n glyphs of 5
// with a gap after all but the last, so "HI" is 11 at scale 1 and 22 at scale 2, and it is
// exactly what `write_text` answers — an empty string included (0), and a scale below 1, which
// draws at 1 and measures at 1.  `Metrics.width` is the ADVANCE extent, what a box is reserved
// by: one trailing gap more.
fn test_measured_is_drawn() {
  cv = canvas(64, 32, 0);
  assert(text_width("HI", 1) == 11 && text_width("HI", 2) == 22, "5 + 1 + 5, then doubled");
  assert(write_text(cv, "HI", 0, 0, 0xFFFFFFFF, 2) == text_width("HI", 2), "drawn = measured");
  assert(write_text(cv, "", 0, 0, 0xFFFFFFFF, 1) == 0, "an empty string draws 0 wide");
  assert(write_text(cv, "HI", 0, 0, 0xFFFFFFFF, 0) == text_width("HI", 0), "scale 0 draws and measures at 1");
  assert(metrics_builtin(1).width("HI") == text_width("HI", 1) + 1, "the advance extent has the trailing gap");
}

// @T2D-002 — text is cut by CHARACTERS.  `len` counts characters and `s[a..b]` slices bytes, so
// a count applied as a byte range keeps fewer characters than it measured, and only in text
// that is not ASCII: "héllo"[0..5] is "héll".  `take_chars` takes characters, and `fit_text`
// cuts with it, leaving room for its ".." marker.
fn test_text_is_cut_by_characters() {
  s = "héllo";
  assert(len(s) == 5 && s[0..5] == "héll", "a byte range of 5 is four characters here");
  assert(take_chars(s, 5) == "héllo" && take_chars(s, 2) == "hé", "take_chars counts characters");
  m = metrics_builtin(1);
  assert(m.fit_text("ÉCOLE PRIMAIRE", 30) == "ÉCO..", "five cells: three characters and the marker");
  assert(m.fit_text("ÉCOLE", 30) == "ÉCOLE", "a string that fits comes back untouched");
}

// @T2D-003 — a changing label costs no sheet write.  The atlas rasterises a glyph the first
// time it meets it and never again, so `atlas_writes` — what a GL consumer uploads on — stops
// at the number of distinct glyphs however much text goes through.  A full sheet REFUSES: the
// quad carries cell -1 and draws nothing, rather than another glyph's pixels.
fn test_a_changing_label_costs_no_write() {
  at = atlas_new(1, 16);
  for i in 0..600 { _ = at.layout("{i % 10}", 0, 0); }
  assert(at.atlas_writes() == 10 && at.atlas_glyph_count() == 10, "ten digits, ten writes");
  for i in 0..600 { _ = at.layout("{i % 10}", 0, 0); }
  assert(at.atlas_writes() == 10, "and none after");
  full = atlas_new(1, 2);
  q = full.layout("ABC", 0, 0);
  assert(q[0].q_cell == 0 && q[1].q_cell == 1 && q[2].q_cell == -1, "the third glyph has no room");
}
