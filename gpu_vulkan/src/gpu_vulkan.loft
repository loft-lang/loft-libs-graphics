//
// The Vulkan backend of `gpu`, on Linux.
//
//   dev = gpu::open(gpu_vulkan::table(), 960, 720, "view") ?? return;
//
// A game does not name this library: `gpu_host` asks each backend in turn.  A program's
// source for it carries the tag "spirv": a SPIR-V 1.3 module as base64 text, which
// gpu_vulkan/spirv.py writes from the program's "glsl-330" source, so a program is written once:
//   - the inputs read per vertex are `location = 0` onwards, in the program's order, and the
//     inputs read per copy follow them;
//   - the uniform block is at set 0, binding 0, std140; a block laid out otherwise than the
//     program declares builds no pipeline, and stderr shows both layouts;
//   - texture slot n is a `sampler2D` at set 0, binding 1 + n;
//   - a program that draws points writes `gl_PointSize`.

fn gv_table() -> integer;
#c "gv_table" "int64_t()"

// This backend's table, for `gpu::open`; 0 on a machine it has no window host for.  `open`
// answers null where no Vulkan 1.3 driver draws into the window.
pub fn table() -> i64 {
  gv_table()
}

fn gv_check(on: integer);
#c "gv_check" "void(int64_t)"
fn gv_faults() -> integer;
#c "gv_faults" "int64_t()"
fn gv_checked() -> integer;
#c "gv_checked" "int64_t()"
fn gv_check_self() -> integer;
#c "gv_check_self" "int64_t()"

// Whether this library was built checked (`c/checked.sh`) and its checks are on.  The library
// as it is published is not, and pays nothing for the checks: `faults` is then always 0.
//
// Vulkan's validation layer (`VK_INSTANCE_LAYERS=VK_LAYER_KHRONOS_validation`) sees a wrong
// call of Vulkan.  A checked build sees what that layer cannot: a buffer, texture, target or
// pipeline of this backend used after its release, released twice, or used after its device
// closed.  The call is refused, counted, and written to stderr with the call it came from.
// `GPU_VULKAN_DEBUG=abort` stops the program at the first fault, `GPU_VULKAN_DEBUG=0` turns
// the checks off.
pub fn checked() -> boolean {
  gv_checked() != 0
}

// Turn a checked build's checks off, or on again.  Ask before `table()`: a device opened
// through a table taken earlier keeps what that table did.
pub fn check(on: boolean) {
  gv_check(if on { 1 } else { 0 });
}

// How many faults a checked build has seen in this program.
pub fn faults() -> integer {
  gv_faults()
}

// For this library's own tests: release one buffer of the window opened last twice, then give
// it to a draw, as no program can through `gpu`, and answer how many faults that added — 2 in a
// checked build with its checks on (and not set to abort), 0 otherwise.
pub fn check_catches() -> integer {
  gv_check_self()
}
