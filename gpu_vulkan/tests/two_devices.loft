const FLAT_F: text = `
#version 330 core
layout(std140) uniform Block {{ vec4 color; vec4 at; }};
out vec4 frag;
void main() {{ frag = color; }}
`;
// SPIR-V of FLAT_F (fragment), written by gpu_vulkan/spirv.py: do not edit.
const FLAT_F_SPV: text = `AwIjBwADAQALAAgAEgAAAAAAAAARAAIAAQAAAAsABgABAAAAR0xTTC5zdGQuNDUwAAAAAA4AAwAA
AAAAAQAAAA8ABgAEAAAABAAAAG1haW4AAAAACQAAABAAAwAEAAAABwAAAEcABAAJAAAAHgAAAAAA
AABHAAMACgAAAAIAAABIAAUACgAAAAAAAAAjAAAAAAAAAEgABQAKAAAAAQAAACMAAAAQAAAARwAE
AAwAAAAhAAAAAAAAAEcABAAMAAAAIgAAAAAAAAATAAIAAgAAACEAAwADAAAAAgAAABYAAwAGAAAA
IAAAABcABAAHAAAABgAAAAQAAAAgAAQACAAAAAMAAAAHAAAAOwAEAAgAAAAJAAAAAwAAAB4ABAAK
AAAABwAAAAcAAAAgAAQACwAAAAIAAAAKAAAAOwAEAAsAAAAMAAAAAgAAABUABAANAAAAIAAAAAEA
AAArAAQADQAAAA4AAAAAAAAAIAAEAA8AAAACAAAABwAAADYABQACAAAABAAAAAAAAAADAAAA+AAC
AAUAAABBAAUADwAAABAAAAAMAAAADgAAAD0ABAAHAAAAEQAAABAAAAA+AAMACQAAABEAAAD9AAEA
OAABAA==`;

fn flat() -> gpu::Program {
  gpu::Program {
    vertex: [gpu::F3],
    instance: [],
    block: [gpu::F4, gpu::F4],
    textures: 0,
    sources: [gpu::source("spirv", FLAT_V_SPV, FLAT_F_SPV)],
  }
}

fn whole() -> vector<single> {
  [-1.0f, -1.0f, 0.0f, 1.0f, -1.0f, 0.0f, 1.0f, 1.0f, 0.0f, -1.0f, -1.0f, 0.0f, 1.0f, 1.0f, 0.0f, -1.0f, 1.0f, 0.0f]
}

// The rectangle scaled by (sx, sy) about (cx, cy), in one colour.
fn fill(dev: gpu::Device, pipe: const gpu::Pipeline, mesh: const gpu::Buffer, r: float, g: float, b: float, cx: float, sx: float) {
  u = pipe.block();
  u.f4(0, r, g, b, 1.0);
  u.f4(1, cx, 0.0, sx, 1.0);
  dev.bind(pipe);
  dev.uniforms(u);
  dev.vertices(mesh);
  dev.draw(0, 6);
}

// Two devices, their passes interleaved call for call: one green on blue with a red left half,
// the other yellow on black with a white right half, and of another size.
fn test_two_devices_draw_and_read_back_their_own_frames() {
  ao = gpu::open(gpu_vulkan::table(), 64, 48, "one");
  if !display() { return; }
  a = ao ?? return assert(false, "no device");
  b = gpu::open(gpu_vulkan::table(), 32, 24, "two") ?? return assert(false, "no second device beside the first");
  pa = a.pipeline(flat(), gpu::State { depth: gpu::DEPTH_OFF }) ?? return assert(false, "no pipeline on the first");
  pb = b.pipeline(flat(), gpu::State { depth: gpu::DEPTH_OFF }) ?? return assert(false, "no pipeline on the second");
  ma = a.buffer(whole());
  mb = b.buffer(whole());
  a.begin_window(gpu::CLEAR, 0xFF0000FF);
  b.begin_window(gpu::CLEAR, 0xFF000000);
  fill(a, pa, ma, 0.0, 1.0, 0.0, 0.0, 1.0);
  fill(b, pb, mb, 1.0, 1.0, 0.0, 0.0, 1.0);
  fill(a, pa, ma, 1.0, 0.0, 0.0, -0.5, 0.5);
  fill(b, pb, mb, 1.0, 1.0, 1.0, 0.5, 0.5);
  a.end();
  b.end();
  sa = a.capture();
  sb = b.capture();
  assert(len(a.refusals()) == 0 && len(b.refusals()) == 0, "nothing refused: {a.refusals()} {b.refusals()}");
  assert(a.width() == 64 && a.height() == 48 && b.width() == 32 && b.height() == 24, "each keeps its size: {a.width()}x{a.height()} and {b.width()}x{b.height()}");
  assert(len(sa) == 64 * 48 && len(sb) == 32 * 24, "each frame has its own size: {len(sa)} and {len(sb)}");
  assert(sa[24 * 64 + 16] == 0xFFFF0000 && sa[24 * 64 + 48] == 0xFF00FF00, "the first shows red and green: {sa[24 * 64 + 16]:x} {sa[24 * 64 + 48]:x}");
  assert(sb[12 * 32 + 8] == 0xFFFFFF00 && sb[12 * 32 + 24] == 0xFFFFFFFF, "the second shows yellow and white: {sb[12 * 32 + 8]:x} {sb[12 * 32 + 24]:x}");
  // the second is closed; the first draws on and still reads its own
  b.close();
  a.begin_window(gpu::KEEP, 0);
  fill(a, pa, ma, 0.0, 0.0, 1.0, 0.5, 0.5);
  a.end();
  sa = a.capture();
  assert(len(a.refusals()) == 0, "nothing refused after the other closed: {a.refusals()}");
  assert(sa[24 * 64 + 16] == 0xFFFF0000 && sa[24 * 64 + 48] == 0xFF0000FF, "the first drew on after the second closed: {sa[24 * 64 + 16]:x} {sa[24 * 64 + 48]:x}");
}
