// Two backends in one program.  A device keeps the backend it was opened through and so does
// everything made from it: an OpenGL device and a Vulkan device draw side by side, each reading
// its own frame, and an object of one is released into the backend that made it, also after
// the other opened and after its own device closed.
// Without a display every test returns at once.
use gpu;
use gpu_gl;
use gpu_vulkan;

fn display() -> boolean {
  gpu_vulkan::table() != 0 && must_draw((env_variable("DISPLAY") ?? "") != "")
}

// A run that says its tests must draw (`GRAPHICS_TEST_MUST_DRAW=1`: the library CI, on a runner
// it gave a display) fails here, where a test would otherwise return having drawn nothing.
fn must_draw(can: boolean) -> boolean {
  assert(can || (env_variable("GRAPHICS_TEST_MUST_DRAW") ?? "") != "1", "this run's tests must draw (GRAPHICS_TEST_MUST_DRAW=1) and found no display to draw on");
  can
}

const FLAT_V: text = `
#version 330 core
layout(location = 0) in vec3 pos;
layout(std140) uniform Block {{ vec4 color; vec4 at; }};
void main() {{ gl_Position = vec4(pos.xy * at.zw + at.xy, 0.0, 1.0); }}
`;
// SPIR-V of FLAT_V (vertex), written by gpu_vulkan/spirv.py: do not edit.
