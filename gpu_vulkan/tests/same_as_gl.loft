fn program(vertex: text, block: vector<integer>, textures: integer) -> gpu::Program {
  gpu::Program {
    vertex: [gpu::F3],
    instance: [],
    block: block,
    textures: textures,
    sources: [gpu::source("spirv", vertex, PLAIN_F_SPV)],
  }
}

fn test_a_shader_that_does_not_fit_builds_no_pipeline() {
  if !display() { return; }
  dev = gpu::open(gpu_vulkan::table(), 64, 48, "vk-wrong") ?? return assert(false, "no Vulkan device");
  // declared as a vector and a float (the float at byte 16); a vec3 puts it at byte 12
  assert(dev.pipeline(program(WRONG_V_SPV, [gpu::F4, gpu::F1], 0), gpu::State {}) == null, "the float sits at byte 12 in the shader and 16 in the program");
  // every field the shader has is where the program has one; only the size differs
  assert(dev.pipeline(program(SHORT_V_SPV, [gpu::F4, gpu::F1], 0), gpu::State {}) == null, "the shader's block is 16 bytes and the program's 32");
  // a block the program does not declare
  assert(dev.pipeline(program(SHORT_V_SPV, [], 0), gpu::State {}) == null, "the shader has a block and the program none");
  // an input past the program's
  assert(dev.pipeline(program(FAR_V_SPV, [], 0), gpu::State {}) == null, "the shader reads location 3 of one input");
  // not SPIR-V at all
  assert(dev.pipeline(program("not base64 at all!", [], 0), gpu::State {}) == null, "text that is not SPIR-V");
  assert(dev.pipeline(program(PLAIN_F_SPV, [], 0), gpu::State {}) == null, "a fragment stage given as the vertex one");
  assert(dev.pipeline(program(SHORT_V_SPV, [gpu::F4], 0), gpu::State {}) != null, "and a program the shader fits builds");
}
