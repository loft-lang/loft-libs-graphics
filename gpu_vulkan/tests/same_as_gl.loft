//
// The same scene drawn through `gpu` on OpenGL (`gpu_gl`) and on Vulkan gives the same pixels.
// Each test draws one scene from one program — its "glsl-330" source and the "spirv" that
// gpu_vulkan/spirv.py writes from it — once per backend, and compares the two captures whole;
// it also asks that the scene shows more than one colour, so that two empty frames do not pass.
//
// The two stacks are held to the same pixels except where `SAME` below says otherwise.  A
// backend serves a whole program, so each scene is drawn in a function of its own, and every
// object of the first backend is gone before the second opens.  gpu_gl is not a dependency of
// this package: it is the backend this one is measured against.  Without a display every test
// returns at once; where one of the two backends opens no window the test says so and fails.
use gpu;
use gpu_gl;
use gpu_vulkan;

// A display, on a machine this backend has a window host for (Linux).
fn display() -> boolean {
  gpu_vulkan::table() != 0 && must_draw((env_variable("DISPLAY") ?? "") != "")
}

// A run that says its tests must draw (`GRAPHICS_TEST_MUST_DRAW=1`: the library CI, on a runner
// it gave a display) fails here, where a test would otherwise return having drawn nothing.
fn must_draw(can: boolean) -> boolean {
  assert(can || (env_variable("GRAPHICS_TEST_MUST_DRAW") ?? "") != "1", "this run's tests must draw (GRAPHICS_TEST_MUST_DRAW=1) and found no display to draw on");
  can
}

const BLUE = 0xFF0000FF;

// ── the shaders, each written once ──

