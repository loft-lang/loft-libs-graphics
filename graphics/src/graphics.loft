// Build an MVP = proj * translate(x, y, 0) * scale(w, h, 1) without going
// through the generic math::mat4_mul path. The model matrix is sparse, so
// this collapses to 4 column updates on the 16-float projection.
fn build_mvp_2d(proj: const vector<float>, x: float, y: float, w: float, h: float) -> vector<float> {
  bmn_mvp = [
    // column 0 = proj.col0 * w
    proj[0] * w,
    proj[1] * w,
    proj[2] * w,
    proj[3] * w,
    // column 1 = proj.col1 * h
    proj[4] * h,
    proj[5] * h,
    proj[6] * h,
    proj[7] * h,
    // column 2 = proj.col2 (z untouched)
    proj[8],
    proj[9],
    proj[10],
    proj[11],
    // column 3 = proj.col0 * x + proj.col1 * y + proj.col3
    proj[0] * x + proj[4] * y + proj[12],
    proj[1] * x + proj[5] * y + proj[13],
    proj[2] * x + proj[6] * y + proj[14],
    proj[3] * x + proj[7] * y + proj[15]
  ];
  bmn_mvp
}
