// Textured quad vertex shader — samples the full texture with identity UV.
// `glTexImage2D` stores canvas-top at TC.y=0 and the 2D ortho projection
// maps top-left screen coords onto clip-space, so no per-shader V flip is
// needed.  PNG-loaded textures sample the same way.
TEX_VERT_2D = `
#version 330 core
layout (location = 0) in vec3 aPos;
uniform mat4 uMVP;
out vec2 vUV;
void main() {{
    gl_Position = uMVP * vec4(aPos, 1.0);
    vUV = vec2(aPos.x, aPos.y);
}}
`;

// Textured quad fragment shader — alpha-discards fully transparent pixels.
TEX_FRAG_2D = `
#version 330 core
in vec2 vUV;
uniform sampler2D uTex;
out vec4 FragColor;
void main() {{
    vec4 c = texture(uTex, vUV);
    if (c.a < 0.01) discard;
    FragColor = c;
}}
`;

