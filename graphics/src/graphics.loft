// `Painter`'s shaders: the unit quad at z = 0, mapped by `uMVP` onto pixel positions (origin
// top-left, y down).

// Flat-color vertex shader — transforms the unit quad by uMVP.
FLAT_VERT_2D = `
#version 330 core
layout (location = 0) in vec3 aPos;
uniform mat4 uMVP;
void main() {{ gl_Position = uMVP * vec4(aPos, 1.0); }}
`;

// Flat-color fragment shader — the colour and its alpha as one `vec4` uniform.  Not a `vec3` and a
// `float`: llvmpipe (Mesa 26.2) compiles `vec4(uColor, uAlpha)` from those two as `uColor.yzxx`
// when the vertex stage reads one `vec3` input, so a rectangle came out in the wrong colour.
FLAT_FRAG_2D = `
#version 330 core
uniform vec4 uColor;
out vec4 FragColor;
void main() {{ FragColor = uColor; }}
`;

