//
// Input arrives as `Event` values: one variant per kind of host input, each carrying its own
// fields, read with `match` — nothing is latched between events and nothing is read through a
// separate accessor.  This pins the shape a window's `events()` answers (every variant and its
// fields, in the order they are declared) and the KEY_* / MOD_* codes `key` and `mods` carry.
// No window is needed.
use graphics::*;

fn describe(ev: const Event) -> text {
  match ev {
    KeyDown { key, mods, repeat } => "down {key} {mods} {repeat}",
    KeyUp { key, mods } => "up {key} {mods}",
    Text { content } => "text {content}",
    MouseDown { button, x, y } => "press {button} {x} {y}",
    MouseUp { button, x, y } => "release {button} {x} {y}",
    MouseMove { x, y } => "move {x} {y}",
    Wheel { delta, x, y } => "wheel {delta} {x} {y}",
    TouchBegin { id, x, y } => "touch {id} {x} {y}",
    TouchMove { id, x, y } => "drag {id} {x} {y}",
    TouchEnd { id, x, y } => "lift {id} {x} {y}",
    Resize { width, height } => "resize {width}x{height}",
  }
}

fn main() {
  events: vector<Event> = [
    KeyDown { key: graphics::KEY_HOME, mods: graphics::MOD_CTRL | graphics::MOD_SHIFT, repeat: true },
    KeyUp { key: graphics::KEY_ENTER, mods: 0 },
    Text { content: "é!" },
    MouseDown { button: 1, x: 10.25, y: 20.5 },
    MouseUp { button: 4, x: 11.25, y: 21.5 },
    MouseMove { x: 3.5, y: 4.75 },
    Wheel { delta: -2, x: 5.5, y: 6.5 },
    TouchBegin { id: 7, x: 1.5, y: 2.5 },
    TouchMove { id: 7, x: 1.75, y: 2.75 },
    TouchEnd { id: 7, x: 2.25, y: 3.25 },
    Resize { width: 640, height: 480 },
  ];
  seen = "";
  for ev in events { seen += describe(ev) + ";"; }
  assert(seen == "down 149 3 true;up 13 0;text é!;press 1 10.25 20.5;release 4 11.25 21.5;" +
                 "move 3.5 4.75;wheel -2 5.5 6.5;touch 7 1.5 2.5;drag 7 1.75 2.75;lift 7 2.25 3.25;" +
                 "resize 640x480;", "every variant carries its own fields: {seen}");
  // The codes `key` and `mods` carry (the 0.9 table: ASCII lower-cased, named keys above 127).
  assert(graphics::MOD_SHIFT == 1 && graphics::MOD_CTRL == 2 && graphics::MOD_ALT == 4 && graphics::MOD_SUPER == 8);
  assert(graphics::KEY_HOME == 149);
  assert(graphics::KEY_ENTER == 13);
  assert(graphics::KEY_BACKSPACE == 8);
  assert(graphics::KEY_UP == 128 && graphics::KEY_RIGHT == 131);
  assert(graphics::KEY_W == 119 && graphics::KEY_SPACE == 32 && graphics::KEY_ESCAPE == 27);
  println("graphics input events: PASS");
}
