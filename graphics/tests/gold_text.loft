// Golden-image regression for text rendering: the fixture font, rasterised
// through draw_text onto a Canvas and written with save_png, must reproduce a
// committed PNG byte for byte.
//
// Why bytes and not pixels: `graphics` has no PNG DECODER (that is `imaging`,
// which is not a dependency), so the only decoder-free comparison available is
// the encoded file itself.  save_png is deterministic — same pixels in, same
// bytes out — so this pins the whole path: glyph rasterisation, alpha
// compositing, canvas layout and the encoder.
//
// If it fails, it is one of two things, and the sizes tell them apart:
//   * a RENDERING change   — regenerate and eyeball the new PNG before committing
//   * an ENCODER change    — same pixels, different deflate output (a png/flate2
//                            bump); regenerate, and the image will look identical
// Regenerate with:
//   cd graphics && loft test tests/gold_text.loft   (writes tests/_tmp_gold_text.png)
//   cp tests/_tmp_gold_text.png tests/gold/gold-text-fixture.png
use graphics;

// Read a whole file as bytes.  `size` is the BYTE length (`len` counts
// characters and would truncate on any byte that is not valid UTF-8).
fn wex_bytes(path: text) -> vector<integer> {
  out: vector<integer> = [];
  {
    f = file(path);
    n = f.size;
    if n <= 0 { return out; }
    f#format = LittleEndian;
    f#next = 0;
    for _ in 0..n { out += [f#read as u8]; }
  }
  out
}

fn test_text_rendering_matches_the_golden_png() {
  font = graphics::gl_load_font("../examples/LiberationSansNarrow-Bold.ttf");
  assert(font >= 0, "the bundled fixture font must load (handle {font})");

  // A small canvas keeps the encoded image small, so there is less compressed
  // data for an encoder change to perturb.
  cv = graphics::canvas(64, 32, graphics::rgb(255, 255, 255));
  cv.draw_text(font, "AV", 18.0, 4, 4, graphics::rgb(0, 0, 0));

  assert(cv.save_png("_tmp_gold_text.png"), "the render must save");

  got = wex_bytes("_tmp_gold_text.png");
  want = wex_bytes("gold/gold-text-fixture.png");
  assert(len(want) > 0, "the golden PNG must exist — see the regenerate note above");
  assert(len(got) == len(want),
         "encoded size differs: got {len(got)} bytes, golden {len(want)}");
  diffs = 0;
  for i in 0..len(want) {
    if (got[i] ?? 0) != (want[i] ?? 0) { diffs += 1; }
  }
  assert(diffs == 0, "{diffs} of {len(want)} bytes differ from the golden");
}
