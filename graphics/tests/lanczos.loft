  src: vector<integer> = [255,70,150,29,155,139,155,78,198,8,227,160,3,95,200,255,71,247,101,254,235,214,20,57,119,60,31,36,115,148,32,34,53,177,70,140,119,178,165,193,212,13,179,4,239,185,193,206,248,241,74,206,167,72,126,2,29,189,138,45,219,126,59,185,137,240,93,166,208,80,190,116,122,106,1,227,228,248,40,96,192,105,74,161,138,42,84,219,99,101,242,98,102,122,75,164,51,243,168,22,144,185,119,10,253,193,12,102,111,197,79,208,255,19,245,81,122,87,239,39,203,148,174,111,251,188,87,237,74,171,242,27,17,146,104,38,196,42,245,116,160,124,139,248,38,214,255,121,18,122,3,132,163,95,213,19,4,167,198,203,43,44,57,135,219,161,9,61,197,208,50,13,26,166,178,223,66,72,46,78,46,33,202,254,166,55,119,231,37,105,182,96,58,61,50,40,156,174,105,16,0,77,90,185,148,19,185,222,30,222,121,99,3,76,101,160,173,138,252,66,152,122,224,119,214,41,193,110,89,140,59,208,30,10,9,5,231,25,251,196,137,255,239,130,141,202,212,215,191,232,65,140,36,238,148,222,230,86,221,114,255,133,98,237,47,13,43,161,102,77,200,22,162,248,230,32,175,9,207,114,16,88,32,250,182,30,30,144,71,214,236,206,226,4,15,185,0,98,125,32,143,24,136,106,109,89,99,174,58,141,52,84,41,135,197,28,81,192,225,121,214,163,146,180];
