// Premultiplication is the part no one guesses. Resampling straight RGBA lets a
// transparent texel's COLOUR bleed into its neighbours; Pillow premultiplies, so
// it cannot. A fully transparent black half beside an opaque white half must not
// darken the white.
fn test_a_transparent_neighbour_does_not_bleed_its_colour() {
  c = graphics::canvas(8, 2, 0);
  d = &c.data;
  for y in 0..2 {
    for x in 0..8 {
      // Left half: opaque white.  Right half: transparent BLACK.
      d[y * 8 + x] = if x < 4 { 0xFFFFFFFF } else { 0x00000000 };
    }
  }
  out = c.resize_lanczos(4, 1);
  left = out.data[0]?;
  assert(((left >> 16) & 255) == 255, "the opaque white edge stays white, not grey");
  assert(((left >> 24) & 255) == 255, "and stays opaque");
}

// Degenerate sizes answer a canvas rather than a null or a crash.
fn test_a_degenerate_target_is_still_a_canvas() {
  c = graphics::canvas(4, 4, 0xFF102030);
  z = c.resize_lanczos(0, 0);
  assert(z.width == 1 && z.height == 1, "clamped to 1x1, not zero-sized");
}
