//
// @PLN146 W1 — `resize_lanczos`, pinned against PILLOW rather than against
// itself.
//
// The `.draw` corpus renders at 3x and downscales with `Image.LANCZOS`, so W2's
// pixel-comparison is only possible if this reproduces Pillow byte for byte.
// Every expectation below is Pillow 10.2's actual output, captured once and
// written down — a golden generated by the thing being ported would only pin the
// port to itself.
//
// The eight cases exercise the axes that break a resampler: the oracle's exact 3x
// downscale, non-integer ratios, a non-square image, a single-pixel axis, a
// degenerate 3x1 output, and an UPSCALE (where the filter must not widen).
use graphics;

fn from_rgba(fr: const vector<integer>, fw: integer, fh: integer) -> graphics::Canvas {
  c = graphics::canvas(fw, fh, 0);
  d = &c.data;
  for i in 0..(fw * fh) {
    d[i] = (fr[i * 4 + 3]? << 24) | (fr[i * 4]? << 16) | (fr[i * 4 + 1]? << 8) | fr[i * 4 + 2]?;
  }
  c
}

fn differing(dc: const graphics::Canvas, want: const vector<integer>) -> integer {
  n = 0;
  for i in 0..len(want) { if dc.data[i]? != want[i]? { n += 1; } }
  n
}

