// SPDX-License-Identifier: LGPL-3.0-or-later
//
// @PLN146 W3 — `resize_bicubic`, pinned against PILLOW rather than against
// itself.
//
// `Image.resize(size)` with no `resample=` argument is BICUBIC, and `draw.py`
// builds every gradient that way: a 100x100 image enlarged to the shape's
// bounding box.  So the corpus depends on this filter without ever naming it,
// and a port that reads the call site's argument list sees no filter at all.
//
// Every expectation below is Pillow 10.2's actual output, captured once and
// written down.  A golden generated by the thing being ported would only pin the
// port to itself.
//
// ⚠ The first case is the one the corpus actually walks, and it is an
// ENLARGEMENT: bicubic has negative lobes, so it overshoots the source's range.
// A resampler that clamps that away passes a smoothness eyeball and fails here.
use graphics;

fn from_rgba(fr: const vector<integer>, fw: integer, fh: integer) -> graphics::Canvas {
  c = graphics::canvas(fw, fh, 0);
  d = &c.data;
  for i in 0..(fw * fh) {
    d[i] = (fr[i * 4 + 3]? << 24) | (fr[i * 4]? << 16) | (fr[i * 4 + 1]? << 8) | fr[i * 4 + 2]?;
  }
  c
}

fn differing(dc: const graphics::Canvas, want: const vector<integer>) -> integer {
  n = 0;
  for i in 0..len(want) { if dc.data[i]? != want[i]? { n += 1; } }
  n
}

