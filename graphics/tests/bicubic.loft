fn test_the_negative_lobes_overshoot_and_that_is_the_filter() {
  // A hard 40 -> 200 step, enlarged 4x.  Pillow's answer spans 28..212 — OUTSIDE
  // the source's own range, because the kernel goes negative either side of the
  // peak.  Pinned separately from the goldens because it is the property a
  // "smooth enough" resampler quietly loses.
  step: vector<integer> = [];
  for i in 0..10000 {
    step += [if (i % 100) <= 50 { 40 } else { 200 }, 0, 0, 255];
  }
  got = from_rgba(step, 100, 100).resize_bicubic(400, 400);
  lo = 255;
  hi = 0;
  for i in 0..(400 * 400) {
    v = (got.data[i]? >> 16) & 255;
    if v < lo { lo = v; }
    if v > hi { hi = v; }
  }
  assert(lo == 28, "undershoots to 28, got {lo}");
  assert(hi == 212, "overshoots to 212, got {hi}");
}
