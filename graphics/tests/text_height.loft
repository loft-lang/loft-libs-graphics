// @P340/#252 regression: a font's line height is its real one (ascent + descent + line gap,
// rounded up to whole pixels), not a `size * 1.2` guess.  Paired with its ascent — a line is
// sensibly taller than the ascent and grows with the requested size.
use graphics::*;

fn test_text_height_uses_real_metrics() {
  // The bundled fixture, program-relative (#255), and NOT a graceful skip — see font_ascent.loft.
  loaded = graphics::load_font("../examples/LiberationSansNarrow-Bold.ttf");
  assert(loaded != null, "the bundled fixture font must load");
  f = loaded ?? return;
  h_small = f.line_height(20.0);
  h_large = f.line_height(40.0);
  assert(h_small > 0, "line height at 20px should be positive ({h_small})");
  assert(h_large > h_small, "line height grows with size ({h_large} vs {h_small})");
  // Line height = ascent + descent + line gap, so it exceeds the ascent.
  a_large = f.ascent(40.0);
  assert((h_large as float) > a_large,
    "line height should exceed ascent ({h_large} vs {a_large})");
  // …and stay within a sane band of the em (not the loose size*1.2 guess).
  assert(h_large < 60, "line height at 40px should be well under 1.5em ({h_large})");
}
