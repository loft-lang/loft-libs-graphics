//
// A renderer asks whether a group already has its buffers and how many groups a set holds
// (dryopea's ground and entity passes): `GroupMeshes.has` and `count` answer without a window.
use graphics::*;

fn test_a_new_set_holds_no_groups() {
  set = group_meshes(10, DRAW_TRIANGLES);
  assert(set.count() == 0, "a new set holds no groups, got {set.count()}");
  assert(!set.has(7), "and no group 7");
}
