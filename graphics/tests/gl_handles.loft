//
// A program that draws its own textured quad with a painter's shader (crawler's view) reads the
// painter's textured shader and unit quad, and binds a sprite sheet's texture: those fields are
// `pub`.  Building a painter needs a window, so the check is that this file COMPILES — outside the
// file that declares it, a field without `pub` is refused.
use graphics::*;

fn quad_draw(p: const Painter) {
  p.tex.set_int("uTex", 0);
  p.quad.draw(p.tex);
}

fn sheet_texture(s: const Sprites) {
  s.texture.bind(0);
}

fn test_a_custom_draw_reads_the_painter_and_sheet_objects() {
  readers = [quad_draw];
  binders = [sheet_texture];
  assert(len(readers) == 1 && len(binders) == 1, "every reader compiled");
}
