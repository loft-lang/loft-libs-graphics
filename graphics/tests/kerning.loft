// @P339 regression: lib/graphics text rendering must apply kerning pairs.
// Before the fix, `gl_measure_text("AV")` == `measure("A")+measure("V")`
// exactly (no kern table consulted in measure_text / rasterize_text); A–V is
// a textbook negative-kern pair, so the kerned measure must be strictly less.
use graphics::*;

fn test_kerning_pair_narrows_measure() {
  // #255: the path is program-relative (resolved against THIS test file's dir),
  // so the fixture at the package root's examples/ is "../examples/".
  loaded = graphics::load_font("../examples/LiberationSansNarrow-Bold.ttf");
  // NOT a graceful skip — see font_ascent.loft.  A missing font must fail here,
  // otherwise the kerning guard below silently never runs.
  assert(loaded != null, "the bundled fixture font must load");
  f = loaded ?? return;
  av = f.measure("AV", 40.0);
  a = f.measure("A", 40.0);
  v = f.measure("V", 40.0);
  assert(av < a + v, "AV ({av}) should kern narrower than A+V ({a + v})");
  // sanity: a single glyph is unaffected by kerning
  assert(a > 0.0, "A has positive width");
}
