// Gold-image example: text rendered with the bundled fixture font.
//
// Writes gold-text-fixture.png: "AV" at 18 px, kerned, black on white.  tests/text_raster.loft
// draws the same and compares it with tests/gold/gold-text-fixture.png pixel for pixel.
//
// `#cwd` keeps the PNG in the directory the program runs from; `load_font` still finds the font
// beside this file, because a relative font path resolves against the program's own directory.
#cwd

use graphics::*;

fn main() {
  f = load_font("LiberationSansNarrow-Bold.ttf") ?? return;
  cv = canvas(64, 32, rgb(255, 255, 255));
  cv.draw_text(f, "AV", 18.0, 4, 4, rgb(0, 0, 0));
  cv.save_png("gold-text-fixture.png");
}
