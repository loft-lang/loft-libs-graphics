//
// Index lists, instancing, buffer updates and the draw modes on the C shim against 0.9's
// (@PLN208 G5).  A comparison, not a test — see window.loft for why and how to run it; the oracle
// is 0.9 on the interpreter.  One frame through the same steps on both paths: a vertex-coloured
// fan drawn through an index list, a rotated triangle drawn in five instanced copies whose offsets
// are uploaded and then replaced, lines at a width of 3 and points of 6 pixels.
use graphics::*;
use imaging::*;

fn display() -> boolean {
  (env_variable("DISPLAY") ?? "") != ""
}

const V: text = `
#version 330 core
layout(location = 0) in vec3 pos;
layout(location = 2) in vec4 col;
layout(location = 5) in vec2 offset;
uniform float spread;
out vec4 v_col;
void main() {{ gl_Position = vec4(pos.xy * 0.8 + spread * offset, pos.z, 1.0); v_col = col; }}
`;

const F: text = `
#version 330 core
in vec4 v_col;
out vec4 frag;
void main() {{ frag = v_col; }}
`;

fn vertex(x: float, y: float, r: float, g: float, b: float) -> vector<single> {
  [
    x as single, y as single, 0.0 as single, 0.0 as single, 0.0 as single, 1.0 as single,
    r as single, g as single, b as single, 1.0 as single,
  ]
}

// A centre and five rim points; the index list fans them.
fn fan() -> vector<single> {
  v: vector<single> = [];
  v += vertex(-0.4, 0.2, 1.0, 1.0, 1.0);
  for i in 0..5 {
    a = i as float * 1.2566370614359172 + 0.3;
    v += vertex(
      -0.4 + 0.5 * cos(a),
      0.2 + 0.6 * sin(a),
      0.2 * i as float,
      1.0 - 0.15 * i as float,
      0.5
    );
  }
  v
}

fn fan_indices() -> vector<integer> {
  [0, 1, 2, 0, 2, 3, 0, 3, 4, 0, 4, 5, 0, 5, 1]
}

fn small() -> vector<single> {
  v: vector<single> = [];
  v += vertex(0.0, 0.0, 0.9, 0.3, 0.2);
  v += vertex(0.25, 0.08, 0.2, 0.9, 0.3);
  v += vertex(0.06, 0.27, 0.3, 0.2, 0.9);
  v
}

fn offsets(k: float) -> vector<single> {
  out: vector<single> = [];
  for i in 0..5 {
    out += [(0.15 * i as float + k) as single, (-0.9 + 0.12 * i as float) as single];
  }
  out
}

fn strokes() -> vector<single> {
  v: vector<single> = [];
  v += vertex(-0.9, -0.9, 1.0, 0.0, 0.0);
  v += vertex(0.9, 0.7, 0.0, 0.0, 1.0);
  v += vertex(-0.8, 0.9, 1.0, 1.0, 0.0);
  v += vertex(0.6, -0.8, 0.0, 1.0, 1.0);
  v
}

fn test_buffers_match_0_9() {
  if !display() { return; }
  wo = open_window(96, 72, "g5-buf-new");
  w = wo ?? return assert(false, "no window");
  s = w.shader(V, F) ?? return assert(false, "the shader compiles");
  w.clear(rgba(25, 25, 35, 255));
  f = w.upload(fan(), 10);
  f.indices(fan_indices());
  f.draw_indexed(s, DRAW_TRIANGLES);
  t = w.upload(small(), 10);
  ib = w.instances(offsets(0.0));
  ib.update(offsets(0.1));
  t.instance_attrib(ib, 5, 2, 2, 0);
  s.set_float("spread", 1.0);
  t.draw_instanced(s, 5);
  s.set_float("spread", 0.0);
  lines = w.upload(strokes(), 10);
  w.line_width(3.0);
  lines.draw_mode(s, DRAW_LINES);
  w.point_size(6.0);
  lines.draw_mode(s, DRAW_POINTS);
  got = w.capture();
  w.close();

  assert(gl_create_window(96, 72, "g5-buf-0.9"), "0.9 opens its window");
  p = gl_create_shader(V, F);
  assert(p != 0, "0.9 compiles the shader");
  gl_use_shader(p);
  gl_clear(rgba(25, 25, 35, 255));
  fv = gl_upload_vertices(fan(), 10);
  gl_upload_indices(fv, fan_indices());
  gl_draw_elements(fv, 15, DRAW_TRIANGLES);
  tv = gl_upload_vertices(small(), 10);
  ivbo = gl_upload_instance_buffer(offsets(0.0));
  gl_update_buffer(ivbo, offsets(0.1));
  gl_instance_attrib(tv, ivbo, 5, 2, 2, 0);
  gl_set_uniform_float(p, "spread", 1.0);
  gl_draw_instanced(tv, 3, 5);
  gl_set_uniform_float(p, "spread", 0.0);
  lv = gl_upload_vertices(strokes(), 10);
  gl_line_width(3.0);
  gl_draw_mode(lv, 4, DRAW_LINES);
  gl_point_size(6.0);
  gl_draw_mode(lv, 4, DRAW_POINTS);
  shot = "_tmp_gfx_g5_buf_09.png";
  assert(gl_screenshot(96, 72, shot), "0.9 screenshot");
  gl_destroy_window();
  img = file(shot).png() ?? return assert(false, "0.9 screenshot decodes");
  differ = 0;
  colours: vector<integer> = [];
  for i in 0..96 * 72 {
    q = img.data[i];
    want = rgba(q.r, q.g, q.b, 255);
    if (got.data[i] ?? -1) | 0xFF000000 != want { differ += 1; }
    if len(colours) < 64 {
      seen = false;
      for c in colours {
        if c == want { seen = true; }
      }
      if !seen { colours += [want]; }
    }
  }
  assert(len(colours) >= 20, "the frame is rich: {len(colours)} colours");
  assert(differ == 0, "{differ} of {96 * 72} pixels differ from 0.9");
}
