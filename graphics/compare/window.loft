//
// The window on the C shim against 0.9's (@PLN208 G4).  A comparison, not a test: it needs 0.9's
// Rust crate, which the C backend cannot load, and a display.  Run it on the interpreter and on
// `--native` until 0.10 removes the crate:
//
//   xvfb-run -a -s "-noreset -screen 0 800x600x24" loft --native --tests compare/window.loft
//
// `-noreset`, because an X server that loses its last client resets, and refuses the next window
// while it does.  One file per comparison: 0.9's destroy leaves its dead GL context bound to the
// thread, and no later window in the same process can bind one.
use graphics::*;
use imaging::*;

fn display() -> boolean {
  (env_variable("DISPLAY") ?? "") != ""
}

// 0.9's window (`gl_create_window`, `gl_clear`, `gl_screenshot`) is the reference: a clear through
// the new `Window` reads back the pixels 0.9's screenshot holds.  Translucent colours and channel
// values that do not divide 255 evenly travel through GL's float clear colour on both paths.
// The new windows come first, for the reason above.
fn colours() -> vector<integer> {
  [
    rgba(255, 128, 0, 255),
    rgba(1, 2, 3, 255),
    rgba(77, 160, 254, 128),
    rgba(10, 200, 99, 0),
    rgba(255, 255, 255, 255),
  ]
}

fn test_clear_matches_0_9() {
  if !display() { return; }
  got: vector<Canvas> = [];
  for color in colours() {
    w = open_window(32, 24, "g4") ?? return assert(false, "no window for {color:x}");
    w.clear(color);
    got += [w.capture()];
  }
  assert(gl_create_window(32, 24, "g4-0.9"), "0.9 opens its window");
  shot = "_tmp_gfx_g4_09.png";
  cs = colours();
  for k in 0..len(cs) {
    color = cs[k] ?? 0;
    gl_clear(color);
    assert(gl_screenshot(32, 24, shot), "0.9 screenshot for {color:x}");
    img = file(shot).png() ?? return assert(false, "0.9 screenshot decodes");
    assert(len(img.data) == 32 * 24, "0.9 screenshot for {color:x}: {len(img.data)} pixels");
    mine = got[k];
    for i in 0..32 * 24 {
      p = img.data[i];
      want = rgba(p.r, p.g, p.b, 255);
      g = (mine.data[i] ?? -1) | 0xFF000000;
      assert(g == want, "{color:x} pixel {i}: 0.10 {g:x}, 0.9 {want:x}");
    }
  }
  gl_destroy_window();
}
