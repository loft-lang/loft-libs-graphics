//
// PNG textures on the C shim against 0.9's `gl_load_texture` (@PLN208 G8).  A comparison, not a
// test — see window.loft for why and how to run it; the oracle is 0.9 on the interpreter.  The
// gold PNG (RGB) and a translucent RGBA PNG load both ways and are drawn scaled through the
// painter, linearly filtered, over the same clear colour.
use graphics::*;
use imaging::*;

fn display() -> boolean {
  (env_variable("DISPLAY") ?? "") != ""
}

fn test_png_textures_match_0_9() {
  if !display() { return; }
  src = canvas(5, 4, 0);
  for y in 0..4 {
    for x in 0..5 {
      src.set_pixel(x, y, rgba(40 * x + 30, 60 * y + 20, 200 - 30 * x, 60 * y + 50));
    }
  }
  rgba_path = "{source_dir()}/_tmp_gfx_g8_cmp.png";
  assert(src.save_png(rgba_path), "saved the RGBA PNG");
  gold_path = "{source_dir()}/../tests/gold/gold-text-fixture.png";
  wo = open_window(96, 72, "g8-png-new");
  w = wo ?? return assert(false, "no window");
  p = w.painter() ?? return assert(false, "painter");
  a = w.load_texture(gold_path) ?? return assert(false, "gold loads");
  b = w.load_texture(rgba_path) ?? return assert(false, "rgba loads");
  w.clear(rgba(20, 60, 90, 255));
  p.image(a, 2.0, 3.0, 90.0, 41.0);
  p.image(b, 10.0, 40.0, 70.0, 30.0);
  got = w.capture();
  w.close();

  assert(gl_create_window(96, 72, "g8-png-0.9"), "0.9 opens its window");
  pa = create_painter_2d(96.0, 72.0);
  ta = gl_load_texture(gold_path);
  tb = gl_load_texture(rgba_path);
  assert(ta != 0 && tb != 0, "0.9 loads both");
  gl_clear(rgba(20, 60, 90, 255));
  draw_texture_at(pa, ta, 2.0, 3.0, 90.0, 41.0);
  draw_texture_at(pa, tb, 10.0, 40.0, 70.0, 30.0);
  shot = "_tmp_gfx_g8_09.png";
  assert(gl_screenshot(96, 72, shot), "0.9 screenshot");
  gl_destroy_window();
  img = file(shot).png() ?? return assert(false, "0.9 screenshot decodes");
  differ = 0;
  for i in 0..96 * 72 {
    q = img.data[i];
    if ((got.data[i] ?? -1) | 0xFF000000) != rgba(q.r, q.g, q.b, 255) { differ += 1; }
  }
  assert(differ == 0, "{differ} of {96 * 72} pixels differ from 0.9");
}
