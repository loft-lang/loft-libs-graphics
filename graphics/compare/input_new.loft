//
// Prints every event the 0.10 `Window` delivers, one per line, until Escape is released — the
// 0.10 half of compare/input.sh (@PLN208 G6).
use graphics::*;

fn main() {
  wo = open_window(200, 150, "g6-input");
  if !wo {
    println("no window");
    return;
  }
  w = wo ?? return;
  println("ready");
  frames = 0;
  done = false;
  while !done && frames < 3000 && w.poll() {
    for ev in w.events() {
      match ev {
        KeyDown { key, mods, repeat } => println("KeyDown {key} {mods} {repeat}"),
        KeyUp { key, mods } => {
          println("KeyUp {key} {mods}");
          if key == KEY_ESCAPE { done = true; }
        },
        Text { content } => println("Text {content}"),
        MouseDown { button, x, y } => println("MouseDown {button} {x as integer} {y as integer}"),
        MouseUp { button, x, y } => println("MouseUp {button} {x as integer} {y as integer}"),
        MouseMove { x, y } => println("MouseMove {x as integer} {y as integer}"),
        Wheel { delta, x, y } => println("Wheel {delta} {x as integer} {y as integer}"),
        Resize { width, height } => println("Resize {width} {height}"),
        _ => {}
      }
    }
    w.swap();
    frames += 1;
  }
  println(
    "held {w.key_down(KEY_SHIFT)} mouse {w.mouse_x() as integer} {w.mouse_y() as integer} buttons {w.mouse_buttons()}"
  );
}
