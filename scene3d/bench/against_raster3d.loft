//
// The scene contract's check: one scene through the CPU implementation (`raster3d`, in
// tile-world-game's `local/`) and through this library on `gpu_gl`, the fixed camera at the
// CPU's 800 x 480, the two pictures compared pixel by pixel.
//
//   loft --lib <loft-libs-graphics> --lib <tile-world-game>/local scene3d/bench/against_raster3d.loft
//
// It needs a display.  The scene: a ground of lit cells, blocks a layer high whose faces are
// one group each, a slanted triangle, three actors (the hero behind a block, one turned and
// mirrored, one turned about its middle) and an overlay.  It is not under tests/ because
// `raster3d` is not a library this package can depend on yet; README.md has what it measured.
use gpu;
use gpu_gl;
use scene3d;
use raster3d;

// The numbers of a face, a light box or an actor as the scene takes them: single precision.
fn s(v: const vector<float>) -> vector<single> {
  [for x in v { x as single }]
}

fn rgb565(r: integer, g: integer, b: integer) -> integer { ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3) }

fn wide(v: integer) -> integer {
  r = (v >> 11) & 31; g = (v >> 5) & 63; b = v & 31;
  0xFF000000 | (((r << 3) | (r >> 2)) << 16) | (((g << 2) | (g >> 4)) << 8) | ((b << 3) | (b >> 2))
}

// A picture: a grid of two colours, with a clear corner when `hole`.
fn picture(a: integer, b: integer, hole: boolean) -> vector<i32> {
  out: vector<i32> = [];
  for y in 0..16 {
    for x in 0..16 {
      c = if (x / 4 + y / 4) % 2 == 0 { a } else { b };
      if hole && x < 4 && y < 4 { c = raster3d::NONE; }
      out += [(c & 65535) as i32];
    }
  }
  out
}

fn face(out: vector<float>, pic: integer, group: integer, lx: integer, ly: integer, lz: integer, lk: float, corners: const vector<float>) {
  out += [pic as float, group as float, (len(corners) / 6) as float, lx as float, ly as float, lz as float, lk];
  out += corners;
}

fn land() -> vector<float> {
  out: vector<float> = [];
  for z in 0..8 {
    for x in 0..10 {
      fx = x as float; fz = z as float;
      wall = (x + 2 * z) % 5 == 0;
      if wall {
        // a block a layer high: its top with a light of its own per corner, its south side lit from the cell south of it
        face(out, 1, 100 + x + 16 * z, 0, 0, raster3d::NO_LIGHT, 1.0, [fx, 1.0, fz, 0.0, 0.0, 0.9, fx + 1.0, 1.0, fz, 1.0, 0.0, 0.7, fx + 1.0, 1.0, fz + 1.0, 1.0, 1.0, 0.5, fx, 1.0, fz + 1.0, 0.0, 1.0, 0.8]);
        face(out, 2, 100 + x + 16 * z, x, z + 1, 0, 0.8, [fx, 1.0, fz + 1.0, 0.0, 0.0, 1.0, fx + 1.0, 1.0, fz + 1.0, 1.0, 0.0, 1.0, fx + 1.0, 0.0, fz + 1.0, 1.0, 1.0, 1.0, fx, 0.0, fz + 1.0, 0.0, 1.0, 1.0]);
      } else {
        face(out, 0, -1, x, z, 0, 1.0, [fx, 0.0, fz, 0.0, 0.0, 1.0, fx + 1.0, 0.0, fz, 1.0, 0.0, 1.0, fx + 1.0, 0.0, fz + 1.0, 1.0, 1.0, 1.0, fx, 0.0, fz + 1.0, 0.0, 1.0, 1.0]);
      }
    }
  }
  // a slanted triangle across cells, to try edges that are not on the pixel grid
  face(out, 1, -1, 0, 0, raster3d::NO_LIGHT, 1.0, [1.3, 1.6, 2.2, 0.0, 0.0, 1.0, 4.7, 2.1, 3.4, 1.0, 0.2, 0.6, 2.9, 0.4, 5.8, 0.4, 1.0, 0.9]);
  out
}

fn lights() -> vector<float> {
  out: vector<float> = [0.0, 0.0, 0.0, 10.0, 9.0];
  for z in 0..9 { for x in 0..10 { out += [0.25 + 0.075 * (((x * 7 + z * 3) % 11) as float)]; } }
  out
}

fn main() {
  sky = rgb565(148, 191, 230);
  pics = [picture(rgb565(90, 140, 60), rgb565(70, 110, 50), false), picture(rgb565(170, 170, 180), rgb565(120, 120, 130), false), picture(rgb565(150, 90, 60), rgb565(110, 60, 40), true)];
  faces = land();
  light = lights();
  cam = (-160, -80);
  // the hero (id 1) behind the block at cell (4, 3); one turned and mirrored; one turned about its middle
  actors = [
    1.0, 2.0, 4.5, 0.0, 2.6, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0,
    2.0, 1.0, 6.2, 0.0, 5.5, 1.5, 0.6, 30.0, 0.5, 1.0, 1.0,
    3.0, 0.0, 1.5, 1.0, 1.5, 0.8, 0.9, -45.0, 0.5, 0.5, 0.0,
  ];
  over: vector<i32> = [];
  for y in 0..12 { for x in 0..100 { over += [(if (x / 3 + y / 2) % 3 == 0 { raster3d::NONE } else { rgb565(250 - 2 * x, 40 + 15 * y, 90) } & 65535) as i32]; } }

  cpu = raster3d::new_scene(sky) ?? return;
  for p in pics { _ = raster3d::add_picture(cpu, p); }
  raster3d::set_tile(cpu, 1, s(faces));
  raster3d::set_light(cpu, s(light));
  raster3d::build_scene(cpu, 0.0, 0.0, 0.0);
  raster3d::move_camera(cpu, cam.0, cam.1);
  raster3d::set_actors(cpu, s(actors), 1);
  raster3d::set_overlay(cpu, over, 100, 12, 2);
  frame: vector<i32> = [for _ in 0..raster3d::WIDTH * raster3d::HEIGHT { 0 as i32 }];
  raster3d::draw_frame(cpu, frame);

  dev = gpu::open(gpu_gl::table(), 64, 48, "scene") ?? return;
  scene = scene3d::new_scene(dev, gpu::INTO_COLOUR_DEPTH, wide(sky)) ?? return;
  for p in pics { _ = scene.add_picture(p); }
  scene.set_tile(dev, 1, s(faces));
  scene.set_light(s(light));
  scene.resize(800, 480);
  scene.fixed_camera(cam.0, cam.1);
  scene.set_actors(s(actors), 1);
  scene.set_overlay(dev, over, 100, 12, 2);
  println("hidden groups: {scene.hidden_groups()}");
  colour = dev.texture(800, 480);
  depth = dev.depth_texture(800, 480);
  target = dev.target(colour, depth);
  scene.draw_into(dev, target);
  got = dev.capture_of(target);

  any = 0; far = 0; skyc = 0; worst = 0; first = -1;
  for v in frame {
    c = wide(v);
    g = got[v#index] ?? 0;
    if c == wide(sky) { skyc += 1; }
    if c != g {
      any += 1;
      d = 0;
      for sh in [16, 8, 0] { e = ((c >> sh) & 255) - ((g >> sh) & 255); if e < 0 { e = -e; } if e > d { d = e; } }
      if d > worst { worst = d; }
      if d > 8 { far += 1; if first < 0 { first = v#index; } }
    }
  }
  h8 = 0; h16 = 0; h24 = 0; h48 = 0; hmore = 0;
  for v in frame {
    c = wide(v);
    g = got[v#index] ?? 0;
    d = 0;
    for sh in [16, 8, 0] { e = ((c >> sh) & 255) - ((g >> sh) & 255); if e < 0 { e = -e; } if e > d { d = e; } }
    if d == 0 { continue; }
    if d <= 8 { h8 += 1; } else if d <= 16 { h16 += 1; } else if d <= 24 { h24 += 1; } else if d <= 48 { h48 += 1; } else { hmore += 1; }
  }
  println("by 1..8: {h8}  9..16: {h16}  17..24: {h24}  25..48: {h48}  more: {hmore}");
  println("pixels {len(frame)}  sky {skyc}  differ at all {any}  by more than 8 a channel {far}  worst {worst}  first far at ({first % 800},{first / 800}): cpu {wide(frame[if first < 0 { 0 } else { first }] ?? 0):x} gpu {got[if first < 0 { 0 } else { first }] ?? 0:x}");
  println("refused: {dev.refusals()}");
}
