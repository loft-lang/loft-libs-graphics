//
// A town seen by the free camera is one picture on every backend this machine has, but for
// the pixels an edge runs through the middle of.
//
// THE TOLERANCE, measured on an Apple M3 Max, `gpu_metal` against `gpu_gl`:
//   - a scene whose edges lie on pixel borders (tests/pixels.loft, tests/torches.loft, and the
//     backends' own suites) is the same byte for byte;
//   - a scene in perspective differs in single pixels where a face's edge, or the border of two
//     texels, passes within rounding of a pixel's middle: the pixel then shows the face or the
//     texel on the other side.  At 960 x 720, 12 views of the town of gpu_host/bench: 336 of
//     their 691,200 pixels each in all, at most 39 in one; its 600th frame: 80 (0.012 %);
//   - that is as much as one backend differs from ITSELF when it draws the same view into a
//     texture instead of the window (OpenGL 358, Metal 371 over the same 12 views), so it is the
//     rasteriser's rounding at an edge, not a difference in what the two are asked to draw;
//   - not the cause: Metal's fast-math compilation (the count is the same with it off).
// So the bound here is a count of pixels and no channel step — a pixel on the wrong side of an
// edge shows another face's colour whole: at most 1 pixel in 5,000.  This test's four views at
// 320 x 240 differ in 0, 0, 2 and 0 pixels.  On Linux, OpenGL against Vulkan: `edge_bound`.
// Without a display, or on a machine with one backend, the test returns at once.
use gpu;
use gpu_gl;
use gpu_metal;
use gpu_vulkan;
use scene3d;

fn display() -> boolean {
  must_draw((env_variable("DISPLAY") ?? "") != "" || (env_variable("GRAPHICS_TEST_WINDOW") ?? "") == "1")
}

// A run that says its tests must draw (`GRAPHICS_TEST_MUST_DRAW=1`: the library CI, on a runner
// it gave a display) fails here, where a test would otherwise return having drawn nothing.
fn must_draw(can: boolean) -> boolean {
  assert(can || (env_variable("GRAPHICS_TEST_MUST_DRAW") ?? "") != "1", "this run's tests must draw (GRAPHICS_TEST_MUST_DRAW=1) and found no display to draw on");
  can
}

fn backends() -> vector<i64> {
  [for t in [gpu_gl::table(), gpu_metal::table(), gpu_vulkan::table()] if t != 0 { t }]
}

fn s(v: const vector<float>) -> vector<single> {
  [for x in v { x as single }]
}

// A picture: a grid of two RGB565 colours.
fn picture(a: integer, b: integer) -> vector<i32> {
  out: vector<i32> = [];
  for y in 0..16 { for x in 0..16 { out += [((if (x / 4 + y / 4) % 2 == 0 { a } else { b }) & 65535) as i32]; } }
  out
}

fn face(out: vector<float>, pic: integer, x: integer, z: integer, lk: float, corners: const vector<float>) {
  out += [pic as float, -1.0, (len(corners) / 6) as float, x as float, z as float, 0.0, lk];
  out += corners;
}

// A town of 16 x 12 cells: ground, and on every fifth cell a block with its top and two sides.
fn town() -> vector<float> {
  out: vector<float> = [];
  for z in 0..12 {
    for x in 0..16 {
      fx = x as float;
      fz = z as float;
      if (x + 2 * z) % 5 == 0 {
        face(out, 1, x, z, 1.0, [fx, 1.0, fz, 0.0, 0.0, 1.0, fx + 1.0, 1.0, fz, 1.0, 0.0, 1.0, fx + 1.0, 1.0, fz + 1.0, 1.0, 1.0, 1.0, fx, 1.0, fz + 1.0, 0.0, 1.0, 1.0]);
        face(out, 2, x, z, 0.8, [fx, 1.0, fz + 1.0, 0.0, 0.0, 1.0, fx + 1.0, 1.0, fz + 1.0, 1.0, 0.0, 1.0, fx + 1.0, 0.0, fz + 1.0, 1.0, 1.0, 1.0, fx, 0.0, fz + 1.0, 0.0, 1.0, 1.0]);
        face(out, 2, x, z, 0.6, [fx + 1.0, 1.0, fz + 1.0, 0.0, 0.0, 1.0, fx + 1.0, 1.0, fz, 1.0, 0.0, 1.0, fx + 1.0, 0.0, fz, 1.0, 1.0, 1.0, fx + 1.0, 0.0, fz + 1.0, 0.0, 1.0, 1.0]);
      } else {
        face(out, 0, x, z, 1.0, [fx, 0.0, fz, 0.0, 0.0, 1.0, fx + 1.0, 0.0, fz, 1.0, 0.0, 1.0, fx + 1.0, 0.0, fz + 1.0, 1.0, 1.0, 1.0, fx, 0.0, fz + 1.0, 0.0, 1.0, 1.0]);
      }
    }
  }
  out
}

// Four views of the town from the south-east, each a step further round.
fn views(table: i64) -> vector<vector<u32>> {
  out: vector<vector<u32>> = [];
  dev = gpu::open(table, 320, 240, "town") ?? return out;
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6) ?? return out;
  _ = scene.add_picture(picture(19270, 17226));
  _ = scene.add_picture(picture(44374, 31696));
  _ = scene.add_picture(picture(38603, 27397));
  scene.set_tile(dev, 1, s(town()));
  for i in 0..4 {
    turn = (20 + 37 * i) as float * PI / 180.0;
    scene.free_camera((8.0 + 9.0 * cos(turn), 5.0, 6.0 + 8.0 * sin(turn)), (8.0, 0.0, 6.0), 55.0);
    scene.draw(dev);
    out += [dev.capture()];
  }
  assert(len(dev.refusals()) == 0, "nothing refused: {dev.refusals()}");
  out
}

// How many of a view's 76,800 pixels two backends may differ in: 1 in 5,000 (15), as Metal and
// OpenGL on a Mac, and as two Vulkan drivers (lavapipe and RADV: 5 to 10 a view).  OpenGL against
// Vulkan on Linux is measured where the OpenGL is llvmpipe (under Xvfb, the only OpenGL there):
// llvmpipe draws every edge about 0.2 of a pixel lower and 0.07 to the left of where the spec's
// arithmetic puts it, where both Vulkan drivers put it within 1/32 of a pixel, so the pixels an
// edge passes near show the other side: 837 to 940 a view.  Bounded at 1 in 70 (1,100).
fn edge_bound(a: text, b: text) -> integer {
  if (a == "gpu_gl" && b == "gpu_vulkan") || (a == "gpu_vulkan" && b == "gpu_gl") { 1100 } else { 15 }
}

// How far two channels of a pixel lie apart at most.
fn apart(a: integer, b: integer) -> integer {
  most = 0;
  for shift in [0, 8, 16, 24] {
    d = ((a >> shift) & 255) - ((b >> shift) & 255);
    if d < 0 { d = -d; }
    if d > most { most = d; }
  }
  most
}

// What a pixel off an edge may lie apart in a channel: nothing between two GPUs.  Apple's
// software renderer, the OpenGL of a Mac with no GPU to give it (a CI runner), rounds a lit
// colour its own way, by 1 or 2 of 255.
fn rounding(first: text) -> integer {
  if first == "gpu_gl" && gpu_gl::renderer() == "Apple Software Renderer" { 2 } else { 0 }
}

fn test_a_town_in_perspective_is_one_picture_but_for_pixels_on_an_edge() {
  if !display() { return; }
  tables = backends();
  if len(tables) < 2 { return; }
  // the first backend against each other one
  first = views(tables[0]);
  first_name = gpu::backend_name();
  for t in tables {
    if t#index == 0 { continue; }
    second = views(t);
    bound = edge_bound(first_name, gpu::backend_name());
    allowed = rounding(first_name);
    assert(len(first) == 4 && len(second) == 4, "both backends drew four views: {len(first)} and {len(second)}");
    for i in 0..4 {
      differ = 0;
      colours = 0;
      for p in first[i] {
        if apart(p as integer, (second[i][p#index] ?? 0) as integer) > allowed { differ += 1; }
        if p != first[i][0] { colours += 1; }
      }
      assert(colours > 10000, "view {i} shows the town: {colours} pixels are not the first one's colour");
      assert(differ <= bound, "view {i}: {differ} of 76800 pixels differ between {first_name} and {gpu::backend_name()}, more than an edge's rounding gives ({bound})");
    }
  }
}
