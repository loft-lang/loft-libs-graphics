// What a scene asks of a backend, read from the recording one, and which walls it cuts away:
// no display is needed.  The expected logs and groups are worked out by hand.
use gpu;
use gpu_record;
use scene3d;

// The numbers of a face, a light box or an actor as the scene takes them: single precision.
fn s(v: const vector<float>) -> vector<single> {
  [for x in v { x as single }]
}

fn lines(of: const vector<text>) -> text {
  out = "";
  for l in of { out += "{l}\n"; }
  out
}

// A face of four corners: the picture, its group, where its light comes from, the corners.
fn quad(pic: integer, group: integer, lit: (integer, integer, integer), corners: const vector<float>) -> vector<float> {
  out = [pic as float, group as float, 4.0, lit.0 as float, lit.1 as float, lit.2 as float, 1.0];
  out += corners;
  out
}

// The ground of cell (x, z) on layer 0, lit from its own cell.
fn ground(x: float, z: float) -> vector<float> {
  quad(0, -1, (x as integer, z as integer, 0), [x, 0.0, z, 0.0, 0.0, 1.0, x + 1.0, 0.0, z, 1.0, 0.0, 1.0, x + 1.0, 0.0, z + 1.0, 1.0, 1.0, 1.0, x, 0.0, z + 1.0, 0.0, 1.0, 1.0])
}

// The south side of a block a layer high on cell (x, z), in group `group`.
fn south(x: float, z: float, group: integer) -> vector<float> {
  quad(0, group, (0, 0, scene3d::NO_LIGHT), [x, 1.0, z + 1.0, 0.0, 0.0, 1.0, x + 1.0, 1.0, z + 1.0, 1.0, 0.0, 1.0, x + 1.0, 0.0, z + 1.0, 1.0, 1.0, 1.0, x, 0.0, z + 1.0, 0.0, 1.0, 1.0])
}

// The top of that block.
fn top(x: float, z: float, group: integer) -> vector<float> {
  quad(0, group, (0, 0, scene3d::NO_LIGHT), [x, 1.0, z, 0.0, 0.0, 1.0, x + 1.0, 1.0, z, 1.0, 0.0, 1.0, x + 1.0, 1.0, z + 1.0, 1.0, 1.0, 1.0, x, 1.0, z + 1.0, 0.0, 1.0, 1.0])
}

fn open() -> gpu::Device {
  gpu_record::reset();
  gpu::open(gpu_record::table(), 800, 480, "scene")!
}

fn test_a_scene_is_two_pipelines_an_atlas_and_a_light_map() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  // The land pipeline: a place, a point on the picture, the picture's slot, the light's cell
  // and factor, an own light; one matrix and two arrays of 64 for the torches; the atlas, the
  // light map, the torches' cells and their reaches.  It tests and writes
  // depth (2).  The overlay's: a place and a point on the picture, one texture, no depth.
  made = lines([
    "open 1 800x480 \"scene\"",
    "pipeline 2 vertex 3 2 2 4 1 instance block 16x1@0 4x64@16 4x64@272 size 528 textures 4",
    "  state shape 0 depth 2 blend 0 cull 0 into 0",
    "pipeline 3 vertex 2 2 instance block size 0 textures 1",
    "  state shape 0 depth 0 blend 0 cull 0 into 0",
    "texture 4 1024x1024 colour",
    "texture_nearest 4 on",
    "texture 5 256x2048 colour",
    "texture_nearest 5 on",
  ]);
  assert(gpu_record::log().starts_with(made), "what a scene is made of:\n{gpu_record::log()}");
  assert(scene.offers_free_camera(), "an implementation on a GPU offers the free camera");
}

fn test_a_frame_draws_each_tile_that_holds_faces_then_the_actors() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  assert(scene.add_picture([for _ in 0..256 { 2016 as i32 }]) == 0, "the first picture is number 0");
  assert(scene.add_picture([2016 as i32]) == -1, "too few texels are no picture");
  // tile 7: two faces of four corners, six vertices each; tile 9: one; tile 8 given and dropped
  scene.set_tile(dev, 7, s(ground(0.0, 0.0) + ground(1.0, 0.0)));
  scene.set_tile(dev, 8, s(ground(5.0, 5.0)));
  scene.set_tile(dev, 9, s(ground(2.0, 0.0)));
  scene.drop_tile(8);
  assert(scene.tiles() == 2, "two tiles hold faces, got {scene.tiles()}");
  // one actor of picture 0: a card of two triangles
  scene.set_actors(s([1.0, 0.0, 0.5, 0.0, 0.5, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0]), -1);
  scene.fixed_camera(0, 0);
  before = gpu_record::log();
  scene.draw(dev);
  // The block is the matrix (its first float 2 * 48 / 800 = 0.12) and the torches' two arrays,
  // dark: its last float is 0.  Handles: the device, two pipelines, the atlas (4), the light
  // map (5), the torches' cells (6) and reaches (7), the cards (8), the overlay's quad (9) and
  // picture (10), then the tiles' buffers 11, 12 and 13.
  drawn = lines([
    "begin 0 clear ff94bfe6",
    "  bind 2",
    "  uniforms floats 528 first 0.120 last 0.000",
    "  sample 0 texture 4",
    "  sample 1 texture 5",
    "  sample 2 texture 6",
    "  sample 3 texture 7",
    "  vertices 11",
    "  draw from 0 count 12 copies 0",
    "  vertices 13",
    "  draw from 0 count 6 copies 0",
    "  vertices 8",
    "  draw from 0 count 6 copies 0",
    "end",
  ]);
  got = gpu_record::log()[len(before)..];
  assert(got == drawn, "a frame:\n{got}");
  assert(len(dev.refusals()) == 0, "nothing refused: {dev.refusals()}");
}

fn test_the_walls_in_front_of_the_hero_are_cut_away_and_shown_again() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  _ = scene.add_picture([for _ in 0..256 { 2016 as i32 }]);
  // Two blocks: one on cell (4, 3), group 11, south of where the hero will stand; one on cell
  // (8, 0), group 12, far to the east.
  scene.set_tile(dev, 1, s(top(4.0, 3.0, 11) + south(4.0, 3.0, 11) + top(8.0, 0.0, 12) + south(8.0, 0.0, 12)));
  // The hero's card: a cell wide and tall, its foot at (4.5, 0, 2.6).  On the screen it lies
  // from y = 2.6 * 40 - 48 = 56 to 104 and x = 192 to 240.  Block 11's top lies from
  // y = 3 * 40 - 48 = 72 to 112 over the same x, and is nearer (further south and higher): cut.
  // Block 12 is at x = 384 to 432: not over the card.
  hero = [1.0, 0.0, 4.5, 0.0, 2.6, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0];
  scene.set_actors(s(hero), 1);
  assert("{scene.hidden_groups()}" == "[11]", "the block south of the hero is cut away: {scene.hidden_groups()}");
  // The hero south of the block, at z = 4.5: the block is behind it, and is shown again.
  scene.set_actors(s([1.0, 0.0, 4.5, 0.0, 4.5, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0]), 1);
  assert("{scene.hidden_groups()}" == "[]", "behind the hero it is shown again: {scene.hidden_groups()}");
  // No actor is the one never hidden: nothing is cut for it.
  scene.set_actors(s(hero), -1);
  assert("{scene.hidden_groups()}" == "[]", "nobody to keep in view: {scene.hidden_groups()}");
}

// The west side of a block a layer high on cell (x, z), in group `group`.
fn west(x: float, z: float, group: integer) -> vector<float> {
  quad(0, group, (0, 0, scene3d::NO_LIGHT), [x, 1.0, z, 0.0, 0.0, 1.0, x, 1.0, z + 1.0, 1.0, 0.0, 1.0, x, 0.0, z + 1.0, 1.0, 1.0, 1.0, x, 0.0, z, 0.0, 1.0, 1.0])
}

fn test_the_free_camera_cuts_away_the_walls_between_its_eye_and_the_hero() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  _ = scene.add_picture([for _ in 0..256 { 2016 as i32 }]);
  // Three walls round a hero whose foot is at (4.5, 0, 2.5), its card a cell wide and tall:
  // group 21, a block on cell (4, 3), south of it; group 22, the west side of cell (2, 2), at
  // x = 2 from z 2 to 3; group 23, a side at x = 4.9 from z 2 to 4, which passes through the
  // card's east edge when it faces south: the lines end a quarter of the card inside its edges,
  // so a wall at its edge is not between.  Each in a tile of its own.
  scene.set_tile(dev, 1, s(top(4.0, 3.0, 21) + south(4.0, 3.0, 21)));
  scene.set_tile(dev, 2, s(west(2.0, 2.0, 22)));
  scene.set_tile(dev, 3, s(west(4.9, 2.0, 23) + west(4.9, 3.0, 23)));
  hero = [1.0, 0.0, 4.5, 0.0, 2.5, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0];
  // From the south and above: the line to the card's middle (4.5, 0.5, 2.5) is at y = 1 after
  // 0.8 of its way, where z = 9 - 0.8 * 6.5 = 3.8: through the block's top.
  scene.free_camera((4.5, 3.0, 9.0), (4.5, 0.5, 2.5), 60.0);
  scene.set_actors(s(hero), 1);
  assert("{scene.hidden_groups()}" == "[21]", "the block between the eye and the hero: {scene.hidden_groups()}");
  // Level with the hero: the line is at z = 4 at y = 0.5, through the block's south side.
  scene.free_camera((4.5, 0.5, 9.0), (4.5, 0.5, 2.5), 60.0);
  assert("{scene.hidden_groups()}" == "[21]", "through its side: {scene.hidden_groups()}");
  // From the north the block is behind the hero.  The camera alone is given: the actors stay.
  scene.free_camera((4.5, 3.0, -4.0), (4.5, 0.5, 2.5), 60.0);
  assert("{scene.hidden_groups()}" == "[]", "behind the hero it is shown again: {scene.hidden_groups()}");
  // From high over the block: the line to the middle is at y = 1 where z = 4.5 - 2 * 8 / 8.5 =
  // 2.62, north of the block's top.
  scene.free_camera((4.5, 9.0, 4.5), (4.5, 0.5, 2.5), 60.0);
  assert("{scene.hidden_groups()}" == "[]", "over the block, the hero is seen: {scene.hidden_groups()}");
  // From the west, level: the line crosses x = 2 at z = 2.5, y = 0.5.
  scene.free_camera((0.5, 0.5, 2.5), (4.5, 0.5, 2.5), 60.0);
  assert("{scene.hidden_groups()}" == "[22]", "the side west of the hero: {scene.hidden_groups()}");
  // The actors first, then the camera: the same walls.
  scene.set_actors(s([1.0, 0.0, 4.5, 0.0, 6.5, 1.0, 1.0, 0.0, 0.5, 1.0, 0.0]), 1);
  assert("{scene.hidden_groups()}" == "[]", "the hero south of every wall, seen from the west: {scene.hidden_groups()}");
  scene.set_actors(s(hero), 1);
  scene.free_camera((4.5, 3.0, 9.0), (4.5, 0.5, 2.5), 60.0);
  assert("{scene.hidden_groups()}" == "[21]", "whichever is given last: {scene.hidden_groups()}");
  // Nobody to keep in view: nothing is cut, whatever was.
  scene.set_actors(s(hero), -1);
  assert("{scene.hidden_groups()}" == "[]", "nobody to keep in view: {scene.hidden_groups()}");
  // The fixed camera after the free one cuts as the fixed camera does: seen from the west only
  // the side at x = 2 is between; on the fixed camera's screen the card lies from y = 2.5 * 40
  // - 48 = 52 to 100 at x 192 to 240, the block's top over it from y = 72, and nearer.
  scene.free_camera((0.5, 0.5, 2.5), (4.5, 0.5, 2.5), 60.0);
  scene.set_actors(s(hero), 1);
  assert("{scene.hidden_groups()}" == "[22]", "the free camera's: {scene.hidden_groups()}");
  // The side at x = 4.9 is cut too: seen from the south it is a strip one pixel wide (x 235) from
  // y = 32 to 160, over the card, and its south end (z = 4) is nearer than the card.
  scene.fixed_camera(0, 0);
  assert("{scene.hidden_groups()}" == "[21,23]", "the fixed camera's: {scene.hidden_groups()}");
}

fn test_a_box_of_light_is_one_write_and_a_few_where_it_crosses_the_maps_edge() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  before = gpu_record::log();
  // Three cells by two on layer 1, from cell (10, 20): one write of 3 x 2 at (10, 20 + 256).
  // Its first light is 1: 65535, red ff and green ff under a full alpha.
  scene.set_light(s([1.0, 10.0, 20.0, 3.0, 2.0, 1.0, 0.5, 0.0, 0.25, 0.75, 1.0]));
  // Four cells in a row from cell (254, 0) on layer 0: the map is 256 cells wide, so two go at
  // x 254 and two at x 0.  The first light is 0.5: 32768, red 80 and green 00.
  scene.set_light(s([0.0, 254.0, 0.0, 4.0, 1.0, 0.5, 0.5, 1.0, 1.0]));
  // A cell west of the origin is the map's last column.
  scene.set_light(s([0.0, -1.0, 0.0, 1.0, 1.0, 0.0]));
  // Too few lights for the box: nothing is written.
  scene.set_light(s([0.0, 0.0, 0.0, 2.0, 2.0, 1.0]));
  got = gpu_record::log()[len(before)..];
  want = lines([
    "texture_put 5 at 10,276 3x2 first ffffff00",
    "texture_put 5 at 254,0 2x1 first ff800000",
    "texture_put 5 at 0,0 2x1 first ffffff00",
    "texture_put 5 at 255,0 1x1 first ff000000",
  ]);
  assert(got == want, "the light's writes:\n{got}");
}

fn test_a_torch_is_its_reach_once_and_nine_numbers_a_frame() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  assert(scene.offers_torches(), "an implementation on a GPU lights torches of their own");
  before = gpu_record::log();
  // Torch 7 on layer 0: a reach of 3 x 2 cells from cell (4, 9), full at its first cell.  It
  // takes the first square of the reach atlas (16 x 16 texels at 0, 0; the reach is 65535:
  // red ff, green ff), and the cells of its box name it: square 0 plus one, in red — the
  // strongest there; green, blue and alpha hold the second to the fourth.
  assert(scene.set_torch_reach(s([7.0, 0.0, 4.0, 9.0, 3.0, 2.0, 1.0, 0.5, 0.25, 0.5, 0.5, 0.25])), "the reach is kept");
  // Torch 8 on the same cells, weaker at the first: it is the second there, in green (square 1
  // plus one), and its square is the atlas's second, at x 16.  0.5 is 32768: red 80, green 00.
  assert(scene.set_torch_reach(s([8.0, 0.0, 4.0, 9.0, 1.0, 1.0, 0.5])), "a second reach");
  assert(scene.torches() == 2, "two torches, got {scene.torches()}");
  got = gpu_record::log()[len(before)..];
  want = lines([
    "texture_put 7 at 0,0 16x16 first ffffff00",
    "texture_put 6 at 4,9 3x2 first 00010000",
    "texture_put 7 at 16,0 16x16 first ff800000",
    "texture_put 6 at 4,9 1x1 first 00010200",
  ]);
  assert(got == want, "two reaches given:\n{got}");
  // A box too large, or with too few numbers, is refused and nothing is written.
  assert(!scene.set_torch_reach(s([9.0, 0.0, 0.0, 0.0, 16.0, 1.0, 1.0])), "16 cells across is too many");
  assert(!scene.set_torch_reach(s([9.0, 0.0, 0.0, 0.0, 2.0, 2.0, 1.0])), "four cells need four numbers");
  // A frame: the torches' numbers go into the block and nothing is written to a texture.  The
  // block's last float is the last torch's colour's fourth, 0.
  scene.set_torches(s([7.0, 4.0, 9.0, 0.0, 1.0, 0.9, 1.0, 0.8, 0.5]));
  mid = gpu_record::log();
  scene.fixed_camera(0, 0);
  scene.draw(dev);
  frame = gpu_record::log()[len(mid)..];
  assert(!frame.contains("texture_put"), "a flicker writes no texture:\n{frame}");
  assert(frame.contains("  uniforms floats 528 first 0.120 last 0.000\n"), "the torches ride in the block:\n{frame}");
  // Moved a cell east, torch 7's old box is ranked again as well as its new one: at cell
  // (4, 9) only torch 8 is left (square 1 plus one, first), and the new box starts at (5, 9).
  mid = gpu_record::log();
  assert(scene.set_torch_reach(s([7.0, 0.0, 5.0, 9.0, 3.0, 2.0, 1.0, 0.5, 0.25, 0.5, 0.5, 0.25])), "moved");
  got = gpu_record::log()[len(mid)..];
  assert(got == lines([
    "texture_put 7 at 0,0 16x16 first ffffff00",
    "texture_put 6 at 4,9 3x2 first 00020000",
    "texture_put 6 at 5,9 3x2 first 00010000",
  ]), "torch 7 moved:\n{got}");
  // Dropped, the cells it reached are ranked again: none is left at cell (5, 9).
  mid = gpu_record::log();
  scene.drop_torch(7);
  got = gpu_record::log()[len(mid)..];
  assert(got == lines(["texture_put 6 at 5,9 3x2 first 00000000"]), "torch 7 dropped:\n{got}");
  assert(scene.torches() == 1, "one torch left");
}

// A tuple as text: a tuple is not formatted as it is.
fn four(t: (integer, integer, integer, integer)) -> text {
  "({t.0},{t.1},{t.2},{t.3})"
}

fn two(t: (integer, integer)) -> text {
  "({t.0},{t.1})"
}

fn test_a_screen_of_another_shape_than_the_window_is_fitted_in_its_middle() {
  dev = open();
  scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6)!;
  // The window is 800 x 480.  A screen of 400 x 300 fits 1.6 times (480 / 300; across it would
  // be 2): 640 x 480, 80 from the left.
  scene.resize(400, 300);
  assert("{four(scene.placed(800, 480))}" == "(80,0,640,480)", "where the screen lies: {four(scene.placed(800, 480))}");
  // The window's pixel (80, 0) is the screen's first; (719, 479) its last, 399.4 and 299.4 in;
  // 40 left of it is 25 screen pixels out.
  assert("{two(scene.screen_point(800, 480, 80, 0))}" == "(0,0)", "its first pixel: {two(scene.screen_point(800, 480, 80, 0))}");
  assert("{two(scene.screen_point(800, 480, 719, 479))}" == "(399,299)", "its last: {two(scene.screen_point(800, 480, 719, 479))}");
  assert("{two(scene.screen_point(800, 480, 40, 10))}" == "(-25,6)", "beside it: {two(scene.screen_point(800, 480, 40, 10))}");
  before = gpu_record::log();
  scene.draw(dev);
  // A texture of the sky and a quad for it (11, 12, after the overlay's picture), made once;
  // the pass cleared black, drawn inside the screen's rectangle: the sky over it by the
  // overlay's pipeline (3), then the land, its matrix for 400 across (2 * 48 / 400 = 0.24).
  fitted = lines([
    "texture 11 1x1 colour",
    "texture_put 11 at 0,0 1x1 first ff94bfe6",
    "buffer 12 floats 24",
    "begin 0 clear ff000000",
    "  viewport 80,0 640x480",
    "  bind 3",
    "  sample 0 texture 11",
    "  vertices 12",
    "  draw from 0 count 6 copies 0",
    "  bind 2",
    "  uniforms floats 528 first 0.240 last 0.000",
    "  sample 0 texture 4",
    "  sample 1 texture 5",
    "  sample 2 texture 6",
    "  sample 3 texture 7",
    "end",
  ]);
  got = gpu_record::log()[len(before)..];
  assert(got == fitted, "a fitted frame:\n{got}");
  // The screen the window's size again: the whole window, cleared to the sky, nothing made.
  scene.resize(800, 480);
  before = gpu_record::log();
  scene.draw(dev);
  got = gpu_record::log()[len(before)..];
  assert(got.starts_with("begin 0 clear ff94bfe6\n  bind 2\n"), "the whole window:\n{got}");
  // A screen of the window's shape at half its size fills it: no bars.
  scene.resize(400, 240);
  assert("{four(scene.placed(800, 480))}" == "(0,0,800,480)", "twice as large: {four(scene.placed(800, 480))}");
  assert(len(dev.refusals()) == 0, "nothing refused: {dev.refusals()}");
}
