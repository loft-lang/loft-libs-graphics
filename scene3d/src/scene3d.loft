//
// A 3D scene, drawn through `gpu`.
//
//   scene = scene3d::new_scene(dev, gpu::INTO_WINDOW, 0xFF94BFE6) ?? return;
//   stone = scene.add_picture(texels);                    // 16 x 16 RGB565, NONE where clear
//   scene.set_tile(key, faces);                           // a square of cells, whole
//   scene.set_light([layer, x0, y0, w, h, …lights]);      // the cells' light, as data
//   …each frame…
//   scene.set_actors(actors, hero);
//   scene.fixed_camera(px, py);
//   scene.draw(dev);                                      // a pass into the window
//
// What a view gives is what tile-world-game's scene contract names, in the arrays its CPU
// implementation (`raster3d`) takes, so one view feeds either: pictures by number, tiles of
// faces under a key, the cells' light, the actors of a frame, the camera.  Units: x east, y up
// in layers, z south; a cell is 1 across, a layer 1 high.
//
// Changes come by key: a tile given again or dropped, a box of light, the actors.  A frame is
// the scene as it is, never what an earlier frame drew.
use gpu;

/// A texel that is not there (RGB565).
pub const NONE = 63519;
/// A face's light that comes from no cell (`set_tile`): its corners' own.
pub const NO_LIGHT = -1000000;

/// The fixed camera's scale: pixels a cell is across, a cell's ground is deep, a layer is tall.
pub const WIDE = 48;
pub const DEEP = 40;
pub const TALL = 48;

// A picture's texels each way, the atlas's pictures each way, and its texels each way.
const TS = 16;
const SLOTS = 64;
const ATLAS = 1024;
// The light map: cells each way on a layer, and the layers it holds, one above the other.
const LIGHT_CELLS = 256;
const LIGHT_LAYERS = 8;
// How many torches a scene draws, the cells a torch's reach is across at most, and the reach
// atlas: a square of REACH + 1 texels a torch, ATLAS_ROW squares a row.
const TORCHES = 64;
const REACH = 15;
const ATLAS_ROW = 8;
// Floats a vertex: its place (3), where it lies on its picture (2), its picture's slot (2), the
// cell its light comes from and the factor (4), its own light (1).
const VERTEX = 12;

const LAND_VERTEX_GLSL: text = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in vec2 aSlot;
layout (location = 3) in vec4 aLit;
layout (location = 4) in float aOwn;
layout (std140) uniform Block {{ mat4 uView; vec4 uPlace[64]; vec4 uColour[64]; }};
uniform sampler2D tex1;
uniform sampler2D tex2;
out vec2 vUV;
flat out vec2 vSlot;
out float vLight;
out vec2 vGrid;
flat out vec4 vTorch;
void main() {{
    gl_Position = uView * vec4(aPos, 1.0);
    vUV = aUV;
    vSlot = aSlot;
    vGrid = aPos.xz;
    vTorch = vec4(0.0);
    float l = aOwn;
    if (aLit.z > -999999.0) {{
        vec2 at = vec2(mod(aLit.x, 256.0) + 0.5, mod(aLit.y, 256.0) + 0.5 + 256.0 * mod(aLit.z, 8.0));
        // a factor under 0 marks a card: its own light, and the torches of the cell it stands on
        if (aLit.w >= 0.0) {{
            vec4 c = textureLod(tex1, at / vec2(256.0, 2048.0), 0.0);
            if (c.a > 0.5) l = (c.r * 255.0 * 256.0 + c.g * 255.0) / 65535.0 * aLit.w;
        }}
        vTorch = textureLod(tex2, at / vec2(256.0, 2048.0), 0.0) * 255.0;
    }}
    vLight = clamp(l, 0.0, 1.0);
}}
`;

