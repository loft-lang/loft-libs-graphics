const LAND_FRAGMENT_GLSL: text = `
#version 330 core
layout (std140) uniform Block {{ mat4 uView; vec4 uPlace[64]; vec4 uColour[64]; }};
in vec2 vUV;
flat in vec2 vSlot;
in float vLight;
in vec2 vGrid;
flat in vec4 vTorch;
uniform sampler2D tex0;
uniform sampler2D tex3;
out vec4 FragColor;
// The light a torch (its square in the atlas plus one; 0: none) gives this point: its reach
// read between the cells' middles, times its glow and colour.  The point is kept inside the
// torch's own square, whose last row and column are dark.
vec3 torch(float id) {{
    if (id < 0.5) return vec3(0.0);
    int s = int(id + 0.5) - 1;
    vec4 p = uPlace[s];
    vec2 t = clamp(vGrid - p.xy, 0.5, 15.5);
    vec2 o = vec2(float(s - 8 * (s / 8)), float(s / 8)) * 16.0;
    vec4 c = texture(tex3, (o + t) / 128.0);
    return (c.r * 255.0 * 256.0 + c.g * 255.0) / 65535.0 * p.z * uColour[s].rgb;
}}
void main() {{
    // a pixel whose middle lies on a texel's edge takes the texel before it, as the CPU does:
    // left to the GPU it is the one after it on some (a Mac's), a pixel off every second row
    vec2 t = clamp(floor(vUV * 16.0 - 0.002), 0.0, 15.0);
    vec4 c = texture(tex0, (vSlot * 16.0 + t + 0.5) / 1024.0);
    if (c.a < 0.5) discard;
    vec3 light = max(max(vec3(vLight), max(torch(vTorch.x), torch(vTorch.y))), max(torch(vTorch.z), torch(vTorch.w)));
    FragColor = vec4(c.rgb * min(light, vec3(1.0)), 1.0);
}}
`;

