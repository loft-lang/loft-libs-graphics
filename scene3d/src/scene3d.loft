GQAAABoAAAANAAAADwAAAD4AAwAaAAAAGAAAAD0ABAAQAAAAHgAAAB0AAAA+AAMAHAAAAB4AAAD9
AAEAOAABAA==`;

const OVER_FRAGMENT_GLSL: text = `
#version 330 core
in vec2 vUV;
uniform sampler2D tex0;
out vec4 FragColor;
void main() {{
    vec4 c = texture(tex0, vUV);
    if (c.a < 0.5) discard;
    FragColor = vec4(c.rgb, 1.0);
}}
`;

